# Answers each connection, each in a task of its own: the API and the
# index (src/packages/api.sayon); the first page (src/pages/home.sayon),
# the guides (src/pages/docs.sayon), and the pages about packages
# (src/packages/pages.sayon), accounts (src/accounts), and the community's
# forum (src/community); and the files of `static`.

filesystem = import("standard/filesystem.sayon")
io = import("standard/io.sayon")
network = import("standard/network.sayon")
strings = import("standard/strings.sayon")
threads = import("standard/threads.sayon")
time = import("standard/time.sayon")
account = import("src/accounts/pages.sayon")
accounts = import("src/accounts/accounts.sayon")
dashboard = import("src/accounts/dashboard.sayon")
profiles = import("src/accounts/profiles.sayon")
community = import("src/community/pages.sayon")
moderation = import("src/community/moderation.sayon")
api = import("src/packages/api.sayon")
docs = import("src/pages/docs.sayon")
home = import("src/pages/home.sayon")
http = import("src/web/http.sayon")
layout = import("src/web/layout.sayon")
registry = import("src/packages/registry.sayon")
sessions = import("src/accounts/sessions.sayon")
site = import("src/packages/pages.sayon")

constant STATIC = "static"

# The cookie that keeps the theme a browser chose.
constant THEME_COOKIE = "sayon_theme"

private function kind_of(path: string) -> string
    match filesystem.extension(path)
        case "css"
            return "text/css; charset=utf-8"
        case "svg"
            return "image/svg+xml"
        case "png"
            return "image/png"
        case "ico"
            return "image/x-icon"
        case _
            return "application/octet-stream"

# A file of `static`, or nothing. One asked for with its version, `?v=`, as
# the pages ask, is kept for a year, since a new version has a new address;
# others for five minutes.
private function static_file(path: string, versioned: boolean) -> http.Response or nothing
    if strings.contains(path, "..") or strings.contains(path, "\\") or path == "/"
        return nothing
    file = STATIC + path
    if not filesystem.is_file(file)
        return nothing
    response = http.respond(200, kind_of(file), io.read_file_bytes(file))
    response.headers["X-Content-Type-Options"] = "nosniff"
    if versioned
        response.headers["Cache-Control"] = "public, max-age=31536000, immutable"
    else
        response.headers["Cache-Control"] = "public, max-age=300"
    return response

# The host and port of an address, such as 127.0.0.1:4100.
private function host_of(address: string) -> string
    start = strings.find(address, "://")
    if start == nothing
        return clone(address)
    return strings.slice(address, start + 3, length(address))

# A registry on this computer is reached at one address, so that its
# cookie and its forms' origin are always the same: pages asked for at
# `localhost` or `[::1]` move to 127.0.0.1.
private function moved(request: http.Request, state: registry.State) -> http.Response or nothing
    if request.method != "GET" or not haskey(request.headers, "host")
        return nothing
    ours = host_of(state.address)
    if request.headers["host"] == ours or not strings.starts_with(ours, "127.0.0.1:")
        return nothing
    port = strings.slice(ours, 9, length(ours))
    if request.headers["host"] == "localhost" + port or request.headers["host"] == "[::1]" + port
        return http.redirect(state.address + request.target, 308)
    return nothing

# Remembers the theme a browser chose, "light" or "dark", in a cookie for a
# year, and goes back to the page it was chosen on.
private function choose_theme(request: http.Request, state: registry.State) -> http.Response
    fields = http.form(request)
    response = http.redirect(account.own_page(account.value(fields, "back"), "/"))
    chosen = account.value(fields, "theme")
    if account.from_here(request, state) and (chosen == "light" or chosen == "dark")
        secure = ""
        if account.secure(state)
            secure = "; Secure"
        response.headers["Set-Cookie"] = "{THEME_COOKIE}={chosen}; Path=/; Max-Age=31536000; SameSite=Lax; HttpOnly{secure}"
    return response

# The theme a request's browser chose, "light" or "dark", or "" for its
# system's.
private function theme_of(request: http.Request) -> string
    chosen = http.cookie(request, THEME_COOKIE)
    if chosen != nothing and (chosen == "light" or chosen == "dark")
        return chosen
    return ""

# The answer to a page's form.
private function sent(request: http.Request, state: registry.State, view: layout.Visitor, parts: Array<string>) -> http.Response
    path = clone(request.path)
    if path == "/theme"
        return choose_theme(request, state)
    if path == "/sign-in"
        return account.sign_in(request, state, view)
    if path == "/sign-up"
        return account.sign_up(request, state, view)
    if path == "/sign-out"
        return account.sign_out(request, state, view)
    if path == "/forgot"
        return account.forgot(request, state, view)
    if path == "/account/tokens"
        return dashboard.make_token(request, state, view)
    if path == "/account/password"
        return dashboard.change_password(request, state, view)
    if path == "/account/email"
        return dashboard.change_email(request, state, view)
    if path == "/account/email/again"
        return dashboard.resend(request, state, view)
    if path == "/account/profile"
        return dashboard.change_profile(request, state, view)
    if path == "/account/sessions"
        return dashboard.sign_out_others(request, state, view)
    if path == "/account/notify"
        return dashboard.change_notify(request, state, view)
    if path == "/account/picture"
        return dashboard.change_picture(request, state, view)
    if path == "/account/picture/remove"
        return dashboard.remove_picture(request, state, view)
    if path == "/community/new"
        return community.start_thread(request, state, view)
    if path == "/community/reply"
        return community.post_reply(request, state, view)
    if path == "/community/edit"
        return community.save_edit(request, state, view)
    if path == "/community/solve"
        return community.solve(request, state, view)
    if path == "/community/report"
        return community.report_post(request, state, view)
    if path == "/community/moderate"
        return moderation.moderate(request, state, view)
    if path == "/community/moderate-post"
        return moderation.moderate_post(request, state, view)
    if path == "/community/reports"
        return moderation.dismiss(request, state, view)
    if path == "/community/members"
        return moderation.change_member(request, state, view)
    if length(parts) == 4 and parts[0] == "account" and parts[1] == "tokens" and parts[3] == "revoke"
        return dashboard.revoke_token(request, state, view, parts[2])
    if length(parts) == 2 and parts[0] == "login"
        return account.login_decision(request, state, view, parts[1])
    if length(parts) == 2 and parts[0] == "reset"
        return account.reset_password(request, state, view, parts[1])
    return http.refuse(405, "pages are read with GET")

# A part of an address's query, or "".
private function asked(request: http.Request, name: string) -> string
    if haskey(request.query, name)
        return clone(request.query[name])
    return ""

# A page of the community's forum: the latest threads, a category's, a
# thread, the forms that start a thread and change a post, and the
# moderators' reports.
private function community_page(request: http.Request, state: registry.State, view: layout.Visitor, parts: Array<string>) -> http.Response
    if length(parts) == 1
        return community.forum_page(state, view, "", asked(request, "q"), asked(request, "page"))
    if length(parts) == 2 and parts[1] == "new"
        return community.new_page(state, view, asked(request, "category"))
    if length(parts) == 2 and parts[1] == "edit"
        return community.edit_page(state, view, asked(request, "thread"), asked(request, "post"))
    if length(parts) == 2 and parts[1] == "reports"
        return moderation.reports_page(state, view, asked(request, "done"))
    if length(parts) == 2
        return community.forum_page(state, view, parts[1], asked(request, "q"), asked(request, "page"))
    if length(parts) == 3
        return community.thread_page(state, view, parts[1], parts[2], asked(request, "done"))
    return site.not_found(view)

# The answer to a request.
function route(request: http.Request, state: registry.State) -> http.Response
    path = clone(request.path)
    if strings.starts_with(path, "/api/") or path == "/api" or strings.starts_with(path, "/index/")
        return api.answer(request, state)
    elsewhere = moved(request, state)
    if elsewhere != nothing
        return elsewhere
    viewer = sessions.account_of(sessions.sessions(state.data), http.cookie(request, sessions.COOKIE))
    picture: string or nothing = nothing
    if viewer != nothing
        known = accounts.accounts(state.data)
        if haskey(known, viewer)
            picture = clone(known[viewer].picture)
    view = layout.Visitor(account = viewer, picture = picture, here = clone(request.target), query = "", theme = theme_of(request), at = clone(request.target))
    parts = api.parts(path)
    if request.method == "POST"
        return sent(request, state, view, parts)
    if request.method != "GET"
        return http.refuse(405, "pages are read with GET, and their forms sent with POST")
    if path == "/"
        return home.home(view)
    if path == "/docs" or strings.starts_with(path, "/docs/")
        slug = strings.trim_end(strings.slice(path, 5, length(path)))
        while strings.starts_with(slug, "/")
            slug = strings.slice(slug, 1, length(slug))
        while strings.ends_with(slug, "/")
            slug = strings.slice(slug, 0, length(slug) - 1)
        position = docs.find(state.guides, slug)
        if position == nothing
            return site.not_found(view)
        return docs.page(state.guides, position, view)
    if path == "/packages" or path == "/search"
        query = ""
        if haskey(request.query, "q")
            query = clone(request.query["q"])
        if path == "/search"
            return http.redirect("/packages?q=" + http.encode(query), 308)
        view.query = clone(query)
        return site.packages(state, view, query)
    if length(parts) > 0 and parts[0] == "community"
        return community_page(request, state, view, parts)
    if path == "/sign-in" or path == "/sign-up"
        next = "/account"
        if haskey(request.query, "next")
            next = account.next_page(request.query["next"], "/account")
        if view.account != nothing
            return http.redirect(next)
        view.here = ""
        if path == "/sign-in"
            return account.sign_in_page(view, next, "", "")
        return account.sign_up_page(view, next, "", "")
    done = ""
    if haskey(request.query, "done")
        done = clone(request.query["done"])
    if path == "/account"
        return dashboard.dashboard(state, view, done)
    if path == "/account/tokens"
        return dashboard.tokens_page(state, view, done)
    if path == "/account/settings"
        return dashboard.settings_page(state, view, done, "", 200, http.cookie(request, sessions.COOKIE))
    if path == "/forgot"
        view.here = ""
        return account.forgot_page(view, false)
    if length(parts) == 2 and parts[0] == "users"
        return profiles.profile(state, view, parts[1])
    if length(parts) == 3 and parts[0] == "users" and parts[2] == "picture"
        return profiles.picture(state, view, parts[1], haskey(request.query, "v"))
    if length(parts) == 2 and parts[0] == "verify"
        view.here = ""
        return account.verify_page(state, view, parts[1])
    if length(parts) == 2 and parts[0] == "packages"
        return site.package(state, view, parts[1])
    if length(parts) == 2 and parts[0] == "login"
        return account.login_page(state, view, parts[1], haskey(request.query, "new"))
    if length(parts) == 2 and parts[0] == "reset"
        view.here = ""
        return account.reset_page(state, view, parts[1])
    found = static_file(path, haskey(request.query, "v"))
    if found != nothing
        return found
    return site.not_found(view)

# How often one computer may do a thing: at most `count` times in
# `seconds`.
type Rule = [count: integer, seconds: integer]

# How often a computer did a thing lately: since when, and how many times.
type Window = [start: integer, count: integer]

# The rule for a request, for those that make accounts, sign in, send
# mail, change a password or a picture, start a sign-in, or post, or
# nothing.
function rule(method: string, path: string) -> Rule or nothing
    if method != "POST"
        return nothing
    match path
        case "/sign-up"
            return Rule(count = 10, seconds = 3600)
        case "/sign-in"
            return Rule(count = 30, seconds = 900)
        case "/forgot"
            return Rule(count = 10, seconds = 3600)
        case "/account/email"
            return Rule(count = 10, seconds = 3600)
        case "/account/email/again"
            return Rule(count = 10, seconds = 3600)
        case "/account/password"
            return Rule(count = 10, seconds = 900)
        case "/account/picture"
            return Rule(count = 20, seconds = 3600)
        case "/api/v1/logins"
            return Rule(count = 30, seconds = 3600)
        case "/community/new"
            return Rule(count = 10, seconds = 3600)
        case "/community/reply"
            return Rule(count = 60, seconds = 3600)
        case "/community/edit"
            return Rule(count = 60, seconds = 3600)
        case "/community/report"
            return Rule(count = 20, seconds = 3600)
        case _
            return nothing

# Counts one more use of a rule by `key`; whether it went past the rule.
# Windows long over are forgotten once there are many.
function limited(update windows: Dict<string, Window>, key: string, rule: Rule, now: integer) -> boolean
    if haskey(windows, key) and windows[key].start + rule.seconds > now
        windows[key].count += 1
        return windows[key].count > rule.count
    if length(windows) > 10000
        old: Array<string> = []
        for name, window in windows
            if window.start + 3600 <= now
                push(old, clone(name))
        for name in old
            remove(windows, name)
    windows[clone(key)] = Window(start = now, count = 1)
    return false

# The answer to a computer that went past a rule.
private function too_many(request: http.Request, rule: Rule) -> http.Response
    minutes = (rule.seconds + 59) / 60
    response = http.refuse(429, "this computer did that {rule.count} times in {minutes} minutes; try again later")
    if not strings.starts_with(request.path, "/api/")
        body = ["<div class=\"auth\">", "  <h1>Too many tries</h1>", "  <p class=\"lead\">This computer did that {rule.count} times in {minutes} minutes. Wait a while, then try again.</p>", "</div>"]
        visitor = layout.Visitor(account = nothing, picture = nothing, here = "", query = "", theme = theme_of(request), at = "/")
        response = layout.page(visitor, "Too many tries · Sayon", body, 429)
    response.headers["Retry-After"] = "{rule.seconds}"
    return response

# Answers `count` connections, or without end: each in a task of its own,
# so that one slow to send its request holds up no one else. The tasks
# share one thread and a file is read or saved without waiting, so each
# change to the data is whole when another task looks; a task that waits
# meanwhile, for a password's hash, mail, or Git, reads the data again
# after. With `count`, it returns once every one is answered.
function serve(update listener: network.Listener, state: registry.State, count: integer or nothing = nothing)
    shared = share(clone(state))
    empty: Dict<string, Window> = []
    windows = share(cell(empty))
    # Changes through the API take turns: a publication runs Git, which
    # other publications must not run at the same time.
    publishing: Channel<boolean> = threads.new_channel(1)
    answering: Array<Task<nothing>> = []
    served = 0
    while count == nothing or served < count
        connection = listener.accept()
        served += 1
        seen = shared
        limits = windows
        turn = publishing
        task = threads.spawn(function()
            outcome = try answer(connection, seen.value, limits, turn)
            if outcome is error
                print("a request failed:", outcome.message)
        )
        if count == nothing
            threads.detach(task)
        else
            push(answering, task)
    while length(answering) > 0
        task = pop(answering)
        if task != nothing
            threads.join(task)

private function answer(update connection: network.Connection, state: registry.State, limits: Shared<Cell<Dict<string, Window>>>, turn: Channel<boolean>)
    # A computer that sends nothing for this long is let go.
    connection.set_timeout(time.seconds(30))
    request = http.read(connection)
    if request == nothing
        return
    if typeof(request) == "Response"
        http.write(connection, request)
        return
    # HEAD is answered as GET would be, without the body.
    with_body = request.method != "HEAD"
    if not with_body
        request.method = "GET"
    found = rule(request.method, request.path)
    if found != nothing
        windows = limits.value.get()
        over = limited(windows, "{request.client} {request.path}", found, time.unix_seconds())
        limits.value.set(windows)
        if over
            http.write(connection, too_many(request, found), with_body)
            return
    alone = request.method != "GET" and strings.starts_with(request.path, "/api/")
    if alone
        threads.send(turn, true)
    response = try route(request, state)
    if alone
        threads.receive(turn)
    if response is error
        print("a request failed:", response.message)
        http.write(connection, http.refuse(500, "the website failed to answer; try again later"), with_body)
        return
    http.write(connection, response, with_body)
