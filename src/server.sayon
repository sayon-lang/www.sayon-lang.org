# Answers each connection in turn: the API and the index
# (src/packages/api.sayon); the first page (src/pages/home.sayon), the
# guides (src/pages/docs.sayon), and the pages about packages
# (src/packages/pages.sayon) and accounts (src/accounts/pages.sayon); and
# the files of `static`. One request at a time, so that publications never
# interleave.

filesystem = import("standard/filesystem.sayon")
io = import("standard/io.sayon")
network = import("standard/network.sayon")
strings = import("standard/strings.sayon")
account = import("src/accounts/pages.sayon")
api = import("src/packages/api.sayon")
docs = import("src/pages/docs.sayon")
home = import("src/pages/home.sayon")
http = import("src/web/http.sayon")
layout = import("src/web/layout.sayon")
registry = import("src/packages/registry.sayon")
sessions = import("src/accounts/sessions.sayon")
site = import("src/packages/pages.sayon")

constant STATIC = "static"

private function kind_of(path: string) -> string
    match filesystem.extension(path)
        case "css"
            return "text/css; charset=utf-8"
        case "js"
            return "text/javascript; charset=utf-8"
        case "svg"
            return "image/svg+xml"
        case "png"
            return "image/png"
        case "ico"
            return "image/x-icon"
        case _
            return "application/octet-stream"

# A file of `static`, or nothing.
private function static_file(path: string) -> http.Response or nothing
    if strings.contains(path, "..") or strings.contains(path, "\\") or path == "/"
        return nothing
    file = STATIC + path
    if not filesystem.is_file(file)
        return nothing
    response = http.respond(200, kind_of(file), io.read_file_bytes(file))
    response.headers["X-Content-Type-Options"] = "nosniff"
    return response

# The host and port of an address, such as 127.0.0.1:4100.
private function host_of(address: string) -> string
    start = strings.find(address, "://")
    if start == nothing
        return clone(address)
    return strings.slice(address, start + 3, length(address))

# A registry on this computer is reached at one address, so that its
# cookie and its forms' origin are always the same: pages asked for at
# `localhost` or `[::1]` move to 127.0.0.1.
private function moved(request: http.Request, state: registry.State) -> http.Response or nothing
    if request.method != "GET" or not haskey(request.headers, "host")
        return nothing
    ours = host_of(state.address)
    if request.headers["host"] == ours or not strings.starts_with(ours, "127.0.0.1:")
        return nothing
    port = strings.slice(ours, 9, length(ours))
    if request.headers["host"] == "localhost" + port or request.headers["host"] == "[::1]" + port
        return http.redirect(state.address + request.target, 308)
    return nothing

# The answer to a page's form.
private function sent(request: http.Request, state: registry.State, view: layout.Visitor, parts: Array<string>) -> http.Response
    path = clone(request.path)
    if path == "/sign-in"
        return account.sign_in(request, state, view)
    if path == "/sign-up"
        return account.sign_up(request, state, view)
    if path == "/sign-out"
        return account.sign_out(request, state, view)
    if path == "/account/tokens"
        return account.make_token(request, state, view)
    if path == "/account/password"
        return account.change_password(request, state, view)
    if length(parts) == 4 and parts[0] == "account" and parts[1] == "tokens" and parts[3] == "revoke"
        return account.revoke_token(request, state, view, parts[2])
    if length(parts) == 2 and parts[0] == "login"
        return account.login_decision(request, state, view, parts[1])
    if length(parts) == 2 and parts[0] == "reset"
        return account.reset_password(request, state, view, parts[1])
    return http.refuse(405, "pages are read with GET")

# The answer to a request.
function route(request: http.Request, state: registry.State) -> http.Response
    path = clone(request.path)
    if strings.starts_with(path, "/api/") or path == "/api" or strings.starts_with(path, "/index/")
        return api.answer(request, state)
    elsewhere = moved(request, state)
    if elsewhere != nothing
        return elsewhere
    viewer = sessions.account_of(sessions.sessions(state.data), http.cookie(request, sessions.COOKIE))
    view = layout.Visitor(account = viewer, here = clone(request.target), query = "")
    parts = api.parts(path)
    if request.method == "POST"
        return sent(request, state, view, parts)
    if request.method != "GET"
        return http.refuse(405, "pages are read with GET, and their forms sent with POST")
    if path == "/"
        return home.home(view)
    if path == "/docs" or strings.starts_with(path, "/docs/")
        slug = strings.trim_end(strings.slice(path, 5, length(path)))
        while strings.starts_with(slug, "/")
            slug = strings.slice(slug, 1, length(slug))
        while strings.ends_with(slug, "/")
            slug = strings.slice(slug, 0, length(slug) - 1)
        position = docs.find(state.guides, slug)
        if position == nothing
            return site.not_found(view)
        return docs.page(state.guides, position, view)
    if path == "/packages" or path == "/search"
        query = ""
        if haskey(request.query, "q")
            query = clone(request.query["q"])
        if path == "/search"
            return http.redirect("/packages?q=" + http.encode(query), 308)
        view.query = clone(query)
        return site.packages(state, view, query)
    if path == "/sign-in" or path == "/sign-up"
        next = "/account"
        if haskey(request.query, "next")
            next = account.next_page(request.query["next"], "/account")
        if view.account != nothing
            return http.redirect(next)
        view.here = ""
        if path == "/sign-in"
            return account.sign_in_page(view, next, "", "")
        return account.sign_up_page(view, next, "", "")
    if path == "/account"
        done = ""
        if haskey(request.query, "done")
            done = clone(request.query["done"])
        return account.account_page(state, view, done)
    if length(parts) == 2 and parts[0] == "packages"
        return site.package(state, view, parts[1])
    if length(parts) == 2 and parts[0] == "login"
        return account.login_page(state, view, parts[1], haskey(request.query, "new"))
    if length(parts) == 2 and parts[0] == "reset"
        view.here = ""
        return account.reset_page(state, view, parts[1])
    found = static_file(path)
    if found != nothing
        return found
    return site.not_found(view)

# Answers `count` connections, or without end.
function serve(update listener: network.Listener, state: registry.State, count: integer or nothing = nothing)
    served = 0
    while count == nothing or served < count
        connection = listener.accept()
        served += 1
        outcome = try answer(connection, state)
        if outcome is error
            print("a request failed:", outcome.message)

private function answer(update connection: network.Connection, state: registry.State)
    request = http.read(connection)
    if request == nothing
        return
    if typeof(request) == "Response"
        http.write(connection, request)
        return
    response = try route(request, state)
    if response is error
        print("a request failed:", response.message)
        http.write(connection, http.refuse(500, "the registry failed to answer; try again later"))
        return
    http.write(connection, response)
