##
A person's public page, /users/<name>: since when their account exists,
the few words they wrote about themselves, the packages they own, and
the threads they started; with the moderators' tools for the account.
##

time = import("standard/time.sayon")
accounts = import("src/accounts/accounts.sayon")
dashboard = import("src/accounts/dashboard.sayon")
pictures = import("src/accounts/pictures.sayon")
forum = import("src/community/forum.sayon")
moderation = import("src/community/moderation.sayon")
community = import("src/community/pages.sayon")
index = import("src/packages/index.sayon")
pages = import("src/packages/pages.sayon")
registry = import("src/packages/registry.sayon")
html = import("src/web/html.sayon")
http = import("src/web/http.sayon")
layout = import("src/web/layout.sayon")

function profile(state: registry.State, view: layout.Visitor, name: string) -> http.Response
    all = accounts.accounts(state.data)
    if not index.valid_name(name) or not haskey(all, name)
        return pages.not_found(view)
    record = clone(all[name])
    body: Array<string> = ["<div class=\"wrap\">"]
    push(body, "  <header class=\"account-head\">")
    push(body, "    " + layout.avatar(name, record.picture))
    role = ""
    given = clone(record.role)
    if given == "admin"
        role = " <span class=\"tag accent\">Admin</span>"
    elseif given == "moderator"
        role = " <span class=\"tag accent\">Moderator</span>"
    push(body, "    <div><h1>{html.text(name)}{role}</h1><p>An account since {html.text(layout.day(record.created))}</p></div>")
    if view.account == name
        push(body, "    <div class=\"buttons head-actions\"><a class=\"button\" href=\"/account/settings#profile\">Edit your profile</a></div>")
    push(body, "  </header>")
    bio = clone(record.bio)
    if bio != nothing
        push(body, "  <p class=\"lead bio\">{html.text(bio)}</p>")
    found = dashboard.owned(state, name)
    push(body, "  <section class=\"section\" aria-labelledby=\"packages-title\">")
    push(body, "    <div class=\"heading\"><h2 id=\"packages-title\">Packages</h2><span class=\"tag\">{length(found)}</span></div>")
    if length(found) == 0
        push(body, "    <div class=\"rows\"><p class=\"empty\">{html.text(name)} owns no packages yet.</p></div>")
    else
        push(body, "    <ul class=\"rows\">")
        for summary in found
            push(body, "      <li><a class=\"row\" href=\"/packages/{summary.name}\"><span class=\"row-title\">{html.text(summary.name)}</span><span class=\"tag\">{html.text(summary.latest)}</span>")
            if summary.description != ""
                push(body, "        <p class=\"row-text\">{html.text(summary.description)}</p>")
            push(body, "      </a></li>")
        push(body, "    </ul>")
    push(body, "  </section>")
    someone = community.member(state, view)
    now = time.unix_seconds()
    started = forum.started_by(forum.threads(state.data), name, community.moderates(someone))
    push(body, "  <section class=\"section\" aria-labelledby=\"threads-title\">")
    push(body, "    <div class=\"heading\"><h2 id=\"threads-title\">Threads</h2><span class=\"tag\">{length(started)}</span></div>")
    if length(started) == 0
        push(body, "    <div class=\"rows\"><p class=\"empty\">{html.text(name)} started no threads yet.</p></div>")
    else
        push(body, "    <ul class=\"rows threads\">")
        shown = 0
        for thread in started
            if shown == 20
                break
            shown += 1
            for line in community.thread_row(thread, now, true)
                push(body, "      " + line)
        push(body, "    </ul>")
    push(body, "  </section>")
    if someone != nothing
        for line in moderation.member_tools(someone.account, someone.name, record, name)
            push(body, "  " + line)
    push(body, "</div>")
    return layout.page(view, "{name} · Sayon", body, 200, true, "", "{name} on Sayon's website: their packages and threads.")

##
An account's picture, as PNG. Asked for at its version's address, as
the pages ask, it is kept for a year, since a new picture has a new
address; otherwise for five minutes.
##
function picture(state: registry.State, view: layout.Visitor, name: string, versioned: boolean) -> http.Response
    all = accounts.accounts(state.data)
    if not index.valid_name(name) or not haskey(all, name)
        return pages.not_found(view)
    if all[name].picture == nothing
        return pages.not_found(view)
    kept = pictures.read(state.data, name)
    if kept == nothing
        return pages.not_found(view)
    response = http.respond(200, "image/png", kept)
    response.headers["X-Content-Type-Options"] = "nosniff"
    response.headers["Content-Security-Policy"] = "default-src 'none'; sandbox"
    if versioned
        response.headers["Cache-Control"] = "public, max-age=31536000, immutable"
    else
        response.headers["Cache-Control"] = "public, max-age=300"
    return response
