# The website's pages for becoming someone: making an account, signing in
# and out, verifying an email address, choosing a new password from a link
# that mail or the operator gives, and approving the sign-ins that `sayon
# login` starts (src/accounts/logins.sayon). An account's own pages are in
# src/accounts/dashboard.sayon.
#
# A browser holds its session in a cookie that it sends only to this site
# and only on its own pages' requests (SameSite), and every form must come
# from one of the website's pages, as browsers say in `Origin`, so that no
# other site can make a signed-in browser act.

strings = import("standard/strings.sayon")
accounts = import("src/accounts/accounts.sayon")
mail = import("src/accounts/mail.sayon")
html = import("src/web/html.sayon")
http = import("src/web/http.sayon")
index = import("src/packages/index.sayon")
layout = import("src/web/layout.sayon")
logins = import("src/accounts/logins.sayon")
registry = import("src/packages/registry.sayon")
sessions = import("src/accounts/sessions.sayon")

constant FOREIGN = "The form did not come from the website's own page, so nothing was done. Open the page again and send it from there."

# Names kept for the website, so that no account seems to speak for it.
private function reserved() -> Array<string>
    return ["admin", "administrator", "moderator", "operator", "packages", "registry", "root", "sayon", "security", "standard", "support"]

# A field of a form, or "" when it has none.
function value(fields: Dict<string, string>, name: string) -> string
    if haskey(fields, name)
        return clone(fields[name])
    return ""

function count_of(count: integer, one: string, many: string) -> string
    if count == 1
        return "1 {one}"
    return "{count} {many}"

# Whether a form came from one of the website's own pages.
function from_here(request: http.Request, state: registry.State) -> boolean
    if not haskey(request.headers, "origin")
        return false
    return request.headers["origin"] == state.address

# Whether the website is reached over HTTPS, so that its cookie must be.
function secure(state: registry.State) -> boolean
    return strings.starts_with(state.address, "https://")

# Mails an account a link that verifies `email` for it; why the mail was
# not sent, or nothing.
function send_verification(state: registry.State, account: string, email: string) -> string or nothing
    all = sessions.verifications(state.data)
    secret = sessions.new_verification(all, account, email)
    sessions.save_verifications(state.data, all)
    text = strings.join(["Hello {account},", "", "Open this link to verify the email address of your account at Sayon's website:", "", state.address + "/verify/" + secret, "", "The link works for a day. If you did not ask for it, ignore this mail: nothing changes without the link.", "", "Sayon"], "\n")
    return mail.send(state.data, mail.Mail(to = clone(email), subject = "Verify your email for Sayon", text = text))

# Mails an account a link that chooses a new password, unless one was sent
# in the last two minutes.
function send_reset(state: registry.State, account: string, email: string)
    all = sessions.resets(state.data)
    if sessions.reset_recently(all, account)
        return
    secret = sessions.new_reset(all, account)
    sessions.save_resets(state.data, all)
    text = strings.join(["Hello {account},", "", "Open this link to choose a new password for your account at Sayon's website:", "", state.address + "/reset/" + secret, "", "The link works once, for an hour. If you did not ask for it, ignore this mail: your password stays as it is.", "", "Sayon"], "\n")
    mail.send(state.data, mail.Mail(to = clone(email), subject = "Choose a new password for Sayon", text = text))

# A page of the website to go to, never another site's: `text`, or
# `fallback` when `text` is not the address of one.
function own_page(text: string, fallback: string) -> string
    if not strings.starts_with(text, "/") or strings.starts_with(text, "//")
        return clone(fallback)
    for symbol in ["\\", "\r", "\n", "\""]
        if strings.contains(text, symbol)
            return clone(fallback)
    return clone(text)

# Where to go once signed in or out: a page of the website, but not back to
# signing in.
function next_page(text: string, fallback: string) -> string
    if strings.starts_with(text, "/sign-")
        return clone(fallback)
    return own_page(text, fallback)

# The code of a sign-in's page, /login/<code>, or nothing.
private function login_code(page: string) -> string or nothing
    if not strings.starts_with(page, "/login/")
        return nothing
    code = strings.slice(page, 7, length(page))
    if not logins.valid_code(code)
        return nothing
    return code

# A code with each letter in its own box.
private function letters(code: string) -> string
    spoken: Array<string> = []
    boxes: Array<string> = []
    for letter in strings.characters(code)
        if letter == "-"
            push(boxes, "<span class=\"dash\">-</span>")
        else
            push(spoken, clone(letter))
            push(boxes, "<span>{letter}</span>")
    return "<div class=\"letters\" role=\"img\" aria-label=\"The code {strings.join(spoken, " ")}\">{strings.join(boxes, "")}</div>"

# A narrow page with one box, as the pages for signing in have.
function boxed(view: layout.Visitor, title: string, inside: Array<string>, after: Array<string>, status: integer) -> http.Response
    body: Array<string> = ["<div class=\"auth\">", "  <div class=\"box\">", "    <div class=\"box-body\">"]
    for line in inside
        push(body, "      " + line)
    push(body, "    </div>")
    push(body, "  </div>")
    for line in after
        push(body, "  " + line)
    push(body, "</div>")
    return layout.page(view, title + " · Sayon", body, status, true, "account")

# The switch between signing in and making an account, as links.
private function account_switch(sign_in: string, sign_up: string, making: boolean) -> string
    first = " aria-current=\"page\""
    second = ""
    if making
        first = ""
        second = " aria-current=\"page\""
    return "<nav class=\"switch\" aria-label=\"Account\"><a href=\"{html.escape(sign_in)}\"{first}>Sign in</a><a href=\"{html.escape(sign_up)}\"{second}>Create account</a></nav>"

# The fields that sign in, or with `making` make an account, ending in the
# button `action`.
private function account_form(making: boolean, next: string, approve: boolean, name: string, wrong: boolean, email: string, action: string) -> Array<string>
    target = "/sign-in"
    if making
        target = "/sign-up"
    out = ["<form method=\"post\" action=\"{target}\">", "  <input type=\"hidden\" name=\"next\" value=\"{html.escape(next)}\">"]
    if approve
        push(out, "  <input type=\"hidden\" name=\"approve\" value=\"yes\">")
    name_hint = ""
    if making
        name_hint = "Lowercase letters, digits, and `_`, starting with a letter. It shows as the owner of what you publish."
    for line in layout.field("Account name", "name", "text", name, "username", name_hint, wrong, " required maxlength=\"64\" autocapitalize=\"none\" spellcheck=\"false\"")
        push(out, "  " + line)
    if making
        for line in layout.field("Email", "email", "email", email, "email", "The website mails a link to verify it, and one to choose a new password if you forget this one. No one else sees it.", false, " required maxlength=\"{accounts.LONGEST_EMAIL}\" autocapitalize=\"none\" spellcheck=\"false\"")
            push(out, "  " + line)
        for line in layout.field("Password", "password", "password", "", "new-password", "At least {accounts.SHORTEST_PASSWORD} characters. A few words in a row are long and easy to remember.", false, " required minlength=\"{accounts.SHORTEST_PASSWORD}\" maxlength=\"{accounts.LONGEST_PASSWORD}\"")
            push(out, "  " + line)
        for line in layout.field("Password again", "again", "password", "", "new-password", "", false, " required")
            push(out, "  " + line)
    else
        for line in layout.field("Password", "password", "password", "", "current-password", "", wrong, " required")
            push(out, "  " + line)
    push(out, "  <button class=\"button primary wide large\" type=\"submit\">{action}</button>")
    push(out, "</form>")
    return out

function sign_in_page(view: layout.Visitor, next: string, name: string, problem: string, status: integer = 200) -> http.Response
    inside: Array<string> = []
    push(inside, account_switch("/sign-in?next={http.encode(next)}", "/sign-up?next={http.encode(next)}", false))
    push(inside, "<h1>Sign in</h1>")
    push(inside, "<p class=\"lead\">To publish packages, and to keep the tokens that publish them.</p>")
    if problem != ""
        push(inside, layout.notice("error", problem))
    for line in account_form(false, next, false, name, problem != "", "", "Sign in")
        push(inside, clone(line))
    after = ["<p class=\"after\"><a href=\"/forgot\">Forgot the password?</a></p>"]
    return boxed(view, "Sign in", inside, after, status)

function sign_up_page(view: layout.Visitor, next: string, name: string, problem: string, status: integer = 200, email: string = "") -> http.Response
    inside: Array<string> = []
    push(inside, account_switch("/sign-in?next={http.encode(next)}", "/sign-up?next={http.encode(next)}", true))
    push(inside, "<h1>Create an account</h1>")
    push(inside, "<p class=\"lead\">One account for Sayon's website: to publish packages, and to keep the tokens that publish them.</p>")
    if problem != ""
        push(inside, layout.notice("error", problem))
    for line in account_form(true, next, false, name, problem != "", email, "Create the account")
        push(inside, clone(line))
    return boxed(view, "Create an account", inside, [], status)

# The page of a sign-in that `sayon login` started, for `view`: approving
# it, or signing in or making an account first; or how it ended.
function login_page(state: registry.State, view: layout.Visitor, code: string, making: boolean = false, name: string = "", problem: string = "", status: integer = 200, email: string = "") -> http.Response
    all = logins.logins(state.data)
    key = logins.find(all, code)
    if key == nothing or not logins.valid_code(code)
        inside = ["<h1>This sign-in is over</h1>", "<p class=\"lead\">A sign-in from <code>sayon login</code> ends once it is finished, or after ten minutes. To sign in, run <code>sayon login</code> again.</p>"]
        return boxed(view, "Sign-in over", inside, [], 410)
    login = clone(all[key])
    machine = html.text(login.machine)
    approved = clone(login.account)
    if approved != nothing
        inside = ["<div class=\"seal\">{layout.CHECK_ICON}</div>", "<h1 class=\"centered\">You're signed in</h1>"]
        push(inside, "<p class=\"lead centered\"><code>sayon login</code> on <strong>{machine}</strong> now publishes as <strong>{html.text(approved)}</strong>. Close this page and go back to your terminal.</p>")
        return boxed(view, "Signed in", inside, [], 200)
    if login.denied
        inside = ["<div class=\"seal\">{layout.STOP_ICON}</div>", "<h1 class=\"centered\">Sign-in denied</h1>"]
        push(inside, "<p class=\"lead centered\"><code>sayon login</code> on <strong>{machine}</strong> gets no token. If you did mean to sign in, run <code>sayon login</code> again.</p>")
        return boxed(view, "Sign-in denied", inside, [], 200)
    page = "/login/" + code
    who = "you"
    account = clone(view.account)
    if account != nothing
        who = "<strong>{html.text(account)}</strong>"
    inside: Array<string> = []
    if account == nothing
        push(inside, account_switch(page, page + "?new=yes", making))
        if making
            push(inside, "<h1>Create an account to approve</h1>")
        else
            push(inside, "<h1>Sign in to approve</h1>")
    else
        push(inside, "<h1>Approve this sign-in?</h1>")
    push(inside, "<div class=\"request\">")
    push(inside, "  <p><code>sayon login</code> on <strong>{machine}</strong> asks to publish packages as {who}.</p>")
    push(inside, "  " + letters(code))
    push(inside, "  <p>Check that your terminal shows this code.</p>")
    push(inside, "</div>")
    if problem != ""
        push(inside, layout.notice("error", problem))
    after: Array<string> = []
    if account == nothing
        action = "Sign in and approve"
        if making
            action = "Create the account and approve"
        for line in account_form(making, page, true, name, problem != "", email, action)
            push(inside, clone(line))
    else
        push(inside, "<form method=\"post\" action=\"{page}\"><input type=\"hidden\" name=\"decision\" value=\"approve\"><button class=\"button primary wide large\" type=\"submit\">Approve</button></form>")
        push(inside, "<form class=\"deny\" method=\"post\" action=\"{page}\"><input type=\"hidden\" name=\"decision\" value=\"deny\"><button class=\"button quiet wide\" type=\"submit\">Deny</button></form>")
        push(after, "<form class=\"after\" method=\"post\" action=\"/sign-out\"><input type=\"hidden\" name=\"next\" value=\"{page}\">Approve only a sign-in you started. Not {html.text(account)}? <button class=\"link\" type=\"submit\">Sign out</button></form>")
    return boxed(view, "Approve a sign-in", inside, after, status)

# The page a form goes back to with a problem: the sign-in's when it came
# from one, or else signing in, or making an account.
private function again(state: registry.State, view: layout.Visitor, next: string, making: boolean, name: string, problem: string, status: integer, email: string = "") -> http.Response
    code = login_code(next)
    if code != nothing
        return login_page(state, view, code, making, name, problem, status, email)
    if making
        return sign_up_page(view, next, name, problem, status, email)
    return sign_in_page(view, next, name, problem, status)

# Approves or denies a sign-in still waiting; whether it was.
private function decide(state: registry.State, code: string, account: string, approve: boolean) -> boolean
    all = logins.logins(state.data)
    key = logins.find(all, code)
    if key == nothing
        return false
    if all[key].account != nothing or all[key].denied
        return false
    if approve
        all[key].account = clone(account)
    else
        all[key].denied = true
    logins.save_logins(state.data, all)
    return true

# Signs the browser in, approves the sign-in it came from when asked, and
# goes on to `next`.
private function signed_in(state: registry.State, account: string, next: string, approve: boolean) -> http.Response
    all = sessions.sessions(state.data)
    id = sessions.start(all, account)
    sessions.save_sessions(state.data, all)
    code = login_code(next)
    if approve and code != nothing
        decide(state, code, account, true)
    response = http.redirect(next)
    response.headers["Set-Cookie"] = sessions.cookie(id, secure(state))
    return response

function sign_in(request: http.Request, state: registry.State, view: layout.Visitor) -> http.Response
    fields = http.form(request)
    name = strings.lower(strings.trim(value(fields, "name")))
    password = value(fields, "password")
    next = next_page(value(fields, "next"), "/account")
    approve = value(fields, "approve") == "yes"
    if not from_here(request, state)
        return again(state, view, next, false, name, FOREIGN, 403)
    all = accounts.accounts(state.data)
    failures = sessions.failures(state.data)
    waiting = sessions.wait_for(failures, name)
    if waiting > 0
        minutes = (waiting + 59) / 60
        return again(state, view, next, false, name, "Too many wrong passwords were given for this account. Try again in {count_of(minutes, "minute", "minutes")}.", 429)
    mistaken = "The account's name or the password is wrong."
    if not haskey(all, name)
        return again(state, view, next, false, name, mistaken, 401)
    # Other requests are answered while the password is checked, so the try
    # counts as wrong until it proves right: tries sent together count each.
    sessions.failed(failures, name)
    sessions.save_failures(state.data, failures)
    if not accounts.password_is(all[name], password)
        return again(state, view, next, false, name, mistaken, 401)
    failures = sessions.failures(state.data)
    if haskey(failures, name)
        sessions.succeeded(failures, name)
        sessions.save_failures(state.data, failures)
    return signed_in(state, name, next, approve)

function sign_up(request: http.Request, state: registry.State, view: layout.Visitor) -> http.Response
    fields = http.form(request)
    name = strings.lower(strings.trim(value(fields, "name")))
    email = strings.lower(strings.trim(value(fields, "email")))
    password = value(fields, "password")
    next = next_page(value(fields, "next"), "/account?done=welcome")
    approve = value(fields, "approve") == "yes"
    if not from_here(request, state)
        return again(state, view, next, true, name, FOREIGN, 403, email)
    all = accounts.accounts(state.data)
    problem = ""
    status = 400
    address_problem = accounts.email_problem(email)
    clash = taken(all, name, email)
    if not index.valid_name(name)
        problem = "An account's name is lowercase letters, digits, and `_`, starting with a letter, 64 characters at most."
    elseif collections_has(reserved(), name)
        problem = "The name `{name}` is kept for the website. Choose another."
    elseif address_problem != nothing
        problem = address_problem
    elseif clash != ""
        problem = clash
        status = 409
    else
        weak = accounts.password_problem(name, password)
        if weak != nothing
            problem = weak
        elseif password != value(fields, "again")
            problem = "The two passwords differ. Type the same password in both."
    if problem != ""
        return again(state, view, next, true, name, problem, status, email)
    # Other requests are answered while the password is hashed, so the
    # accounts are read again after: another may have taken the name or the
    # address meanwhile.
    hashed = accounts.hash_password(password)
    all = accounts.accounts(state.data)
    clash = taken(all, name, email)
    if clash != ""
        return again(state, view, next, true, name, clash, 409, email)
    all[clone(name)] = accounts.new_account(hashed, clone(email), false)
    accounts.save_accounts(state.data, all)
    send_verification(state, name, email)
    return signed_in(state, name, next, approve)

# Why another account keeps this one from being made, since it has the
# name or the address, or "".
private function taken(all: Dict<string, accounts.Account>, name: string, email: string) -> string
    if haskey(all, name)
        return "The name `{name}` is taken. Choose another, or sign in if the account is yours."
    if accounts.with_email(all, email) != nothing
        return "Another account has that email address. Sign in to it, or choose a new password for it from the page for a forgotten password."
    return ""

private function collections_has(names: Array<string>, name: string) -> boolean
    for each in names
        if each == name
            return true
    return false

function sign_out(request: http.Request, state: registry.State, view: layout.Visitor) -> http.Response
    next = next_page(value(http.form(request), "next"), "/")
    if not from_here(request, state)
        return sign_in_page(view, next, "", FOREIGN, 403)
    id = http.cookie(request, sessions.COOKIE)
    if id != nothing
        all = sessions.sessions(state.data)
        sessions.finish(all, id)
        sessions.save_sessions(state.data, all)
    response = http.redirect(next)
    response.headers["Set-Cookie"] = sessions.cookie("", secure(state))
    return response

# Approving or denying a sign-in, from its page.
function login_decision(request: http.Request, state: registry.State, view: layout.Visitor, code: string) -> http.Response
    page = "/login/" + code
    if not from_here(request, state)
        return login_page(state, view, code, false, "", FOREIGN, 403)
    account = clone(view.account)
    if account == nothing
        return http.redirect(page)
    decision = value(http.form(request), "decision")
    if decision == "approve" or decision == "deny"
        decide(state, code, account, decision == "approve")
    return http.redirect(page)

# The page of a link that verifies an email address: it verifies it.
function verify_page(state: registry.State, view: layout.Visitor, secret: string) -> http.Response
    links = sessions.verifications(state.data)
    found = sessions.verification(links, secret)
    expired = ["<h1>This link no longer works</h1>", "<p class=\"lead\">A link that verifies an email address works for a day, and stops once a newer one is sent. Send a new one from your account's settings.</p>", "<p><a class=\"button wide\" href=\"/account/settings\">Your settings</a></p>"]
    if found == nothing
        return boxed(view, "Link expired", expired, [], 410)
    all = accounts.accounts(state.data)
    if not haskey(all, found.account)
        return boxed(view, "Link expired", expired, [], 410)
    holder = accounts.with_email(all, found.email)
    if holder != nothing and holder != found.account
        inside = ["<h1>That address is taken</h1>", "<p class=\"lead\">Another account verified <strong>{html.text(found.email)}</strong> first. Give your account another address in its settings.</p>"]
        return boxed(view, "Address taken", inside, [], 409)
    first = all[found.account].verified == false
    all[found.account].email = clone(found.email)
    all[found.account].verified = true
    accounts.save_accounts(state.data, all)
    remove(links, accounts.hash(secret))
    sessions.save_verifications(state.data, links)
    inside = ["<div class=\"seal\">{layout.CHECK_ICON}</div>", "<h1 class=\"centered\">Your email is verified</h1>"]
    news = "."
    if first
        news = ", which can publish packages now."
    push(inside, "<p class=\"lead centered\"><strong>{html.text(found.email)}</strong> is the address of <strong>{html.text(found.account)}</strong>{news}</p>")
    push(inside, "<p><a class=\"button wide\" href=\"/account\">Your account</a></p>")
    return boxed(view, "Email verified", inside, [], 200)

# The page for a forgotten password: a form, or once sent, what comes next.
function forgot_page(view: layout.Visitor, sent: boolean, problem: string = "", status: integer = 200) -> http.Response
    inside: Array<string> = []
    if sent
        push(inside, "<div class=\"seal\">{layout.CHECK_ICON}</div>")
        push(inside, "<h1 class=\"centered\">Check your email</h1>")
        push(inside, "<p class=\"lead centered\">If an account has that name or address, and its address is verified, a link to choose a new password is on its way. It works once, for an hour.</p>")
        push(inside, "<p><a class=\"button wide\" href=\"/sign-in\">Back to signing in</a></p>")
        return boxed(view, "Check your email", inside, [], status)
    push(inside, "<h1>Forgot the password?</h1>")
    push(inside, "<p class=\"lead\">Give your account's name or email address, and the website mails it a link to choose a new password.</p>")
    if problem != ""
        push(inside, layout.notice("error", problem))
    push(inside, "<form method=\"post\" action=\"/forgot\">")
    for line in layout.field("Account name or email", "who", "text", "", "username", "", problem != "", " required maxlength=\"{accounts.LONGEST_EMAIL}\" autocapitalize=\"none\" spellcheck=\"false\"")
        push(inside, "  " + line)
    push(inside, "  <button class=\"button primary wide large\" type=\"submit\">Mail me a link</button>")
    push(inside, "</form>")
    return boxed(view, "Forgot the password", inside, ["<p class=\"after\"><a href=\"/sign-in\">Back to signing in</a></p>"], status)

# Mails a link that chooses a new password to the verified address of the
# account a name or an address names. The answer is the same whether or
# not there is one, so that it tells no one which accounts exist.
function forgot(request: http.Request, state: registry.State, view: layout.Visitor) -> http.Response
    if not from_here(request, state)
        return forgot_page(view, false, FOREIGN, 403)
    who = strings.lower(strings.trim(value(http.form(request), "who")))
    if who == ""
        return forgot_page(view, false, "Give your account's name or email address.", 400)
    all = accounts.accounts(state.data)
    name = accounts.with_email(all, who)
    if haskey(all, who)
        name = clone(who)
    if name != nothing
        email = clone(all[name].email)
        if email != nothing and all[name].verified == true
            send_reset(state, name, email)
    return forgot_page(view, true)

# The page of a link for choosing a password.
function reset_page(state: registry.State, view: layout.Visitor, secret: string, problem: string = "", status: integer = 200) -> http.Response
    account = sessions.reset_account(sessions.resets(state.data), secret)
    if account == nothing
        inside = ["<h1>This link no longer works</h1>", "<p class=\"lead\">A link for choosing a password works once, for an hour. Ask for a new one.</p>", "<p><a class=\"button wide\" href=\"/forgot\">Mail me a new link</a></p>"]
        return boxed(view, "Link expired", inside, [], 410)
    inside: Array<string> = []
    push(inside, "<h1>Choose a password</h1>")
    push(inside, "<p class=\"lead\">For the account <strong>{html.text(account)}</strong>. You'll be signed in with it, here and from then on.</p>")
    if problem != ""
        push(inside, layout.notice("error", problem))
    push(inside, "<form method=\"post\" action=\"/reset/{html.escape(secret)}\">")
    push(inside, "  <input type=\"text\" name=\"name\" value=\"{html.escape(account)}\" autocomplete=\"username\" hidden>")
    for line in layout.field("Password", "password", "password", "", "new-password", "At least {accounts.SHORTEST_PASSWORD} characters. A few words in a row are long and easy to remember.", problem != "", " required minlength=\"{accounts.SHORTEST_PASSWORD}\" maxlength=\"{accounts.LONGEST_PASSWORD}\"")
        push(inside, "  " + line)
    for line in layout.field("Password again", "again", "password", "", "new-password", "", false, " required")
        push(inside, "  " + line)
    push(inside, "  <button class=\"button primary wide large\" type=\"submit\">Save the password</button>")
    push(inside, "</form>")
    return boxed(view, "Choose a password", inside, [], status)

function reset_password(request: http.Request, state: registry.State, view: layout.Visitor, secret: string) -> http.Response
    if not from_here(request, state)
        return reset_page(state, view, secret, FOREIGN, 403)
    resets = sessions.resets(state.data)
    account = sessions.reset_account(resets, secret)
    if account == nothing
        return reset_page(state, view, secret)
    fields = http.form(request)
    password = value(fields, "password")
    weak = accounts.password_problem(account, password)
    if weak != nothing
        return reset_page(state, view, secret, weak, 400)
    if password != value(fields, "again")
        return reset_page(state, view, secret, "The two passwords differ. Type the same password in both.", 400)
    # The link is used up first, so that it works once, and the accounts
    # read after the password is hashed, since other requests are answered
    # meanwhile.
    remove(resets, accounts.hash(secret))
    sessions.save_resets(state.data, resets)
    hashed = accounts.hash_password(password)
    all = accounts.accounts(state.data)
    if not haskey(all, account)
        return reset_page(state, view, secret)
    all[account].password = hashed
    accounts.save_accounts(state.data, all)
    kept = sessions.sessions(state.data)
    sessions.finish_others(kept, account, nothing)
    sessions.save_sessions(state.data, kept)
    return signed_in(state, account, "/account/settings?done=password", false)

test "pages to go on stay on the website"
    assert(next_page("/packages/strings", "/") == "/packages/strings")
    assert(next_page("/login/BCDF-GHJK", "/") == "/login/BCDF-GHJK")
    for away in ["https://example.com", "//example.com", "/\\example.com", "", "packages", "/sign-in?next=/x", "/a\r\nSet-Cookie: x"]
        assert(next_page(away, "/account") == "/account", away)
    assert(own_page("/sign-in?next=/x", "/") == "/sign-in?next=/x" and own_page("//example.com", "/") == "/")
    assert(login_code("/login/BCDF-GHJK") == "BCDF-GHJK" and login_code("/login/x") == nothing and login_code("/account") == nothing)
