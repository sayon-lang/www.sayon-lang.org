# Profile pictures: a PNG for each account that chose one, kept in
# `<data>/pictures/<name>.png`. The settings page's form sends a PNG or JPEG
# image as it is; the website decodes it, turned as a photo's orientation
# says, takes its middle square, makes it SIDE pixels a side, and keeps
# those pixels alone, so that nothing else the file held stays, such as
# where a photo was taken.

crypto = import("standard/crypto.sayon")
filesystem = import("standard/filesystem.sayon")
graphics = import("standard/graphics.sayon")
io = import("standard/io.sayon")
strings = import("standard/strings.sayon")
threads = import("standard/threads.sayon")
files = import("src/web/files.sayon")

# How many pixels a side a picture is kept at.
constant SIDE = 256

# The most pixels an image sent may have, which its header tells before
# anything is decoded: a photo of a large camera, and no more.
constant MOST_PIXELS = 40000000

# Why bytes sent are not an image the website takes, or "".
function problem(bytes: Array<byte>) -> string
    if length(bytes) == 0
        return "Choose a picture first."
    size = try graphics.image_size(bytes)
    if size is error
        return "That file is not a PNG or JPEG image. Choose a photo or a picture of one of those kinds."
    if size.width * size.height > MOST_PIXELS
        return "That image of {size.width} by {size.height} pixels is too large. Choose one of 40 million pixels at most."
    return ""

# The PNG to keep for an image: its middle square, SIDE pixels a side.
# Fails with ImageError for what does not decode.
function made(bytes: Array<byte>) -> Array<byte>
    image = graphics.decode_image(bytes)
    side = image.width
    if image.height < side
        side = image.height
    canvas = graphics.canvas(SIDE, SIDE)
    canvas.draw_part(image, (image.width - side) / 2, (image.height - side) / 2, side, side, 0, 0, SIDE, SIDE)
    return canvas.png()

# `made` on a thread of its own, since a photo takes a while to decode, and
# the website answers others meanwhile.
function made_apart(bytes: Array<byte>) -> Array<byte>
    sent = clone(bytes)
    making = threads.spawn_parallel(function() -> Array<byte>
        return made(sent)
    )
    return threads.join(making)

private function file_of(data: string, account: string) -> string
    return filesystem.join(filesystem.join(data, "pictures"), account + ".png")

# Keeps an account's picture, and gives its version: the start of its
# SHA-256, which its address carries, so that browsers keep each version.
function keep(data: string, account: string, png: Array<byte>) -> string
    filesystem.create_directory(filesystem.join(data, "pictures"))
    files.save_bytes(file_of(data, account), png)
    return strings.slice(crypto.hex(crypto.sha256(png)), 0, 12)

# An account's picture, or nothing.
function read(data: string, account: string) -> Array<byte> or nothing
    file = file_of(data, account)
    if not filesystem.is_file(file)
        return nothing
    return io.read_file_bytes(file)

# Forgets an account's picture.
function forget(data: string, account: string)
    file = file_of(data, account)
    if filesystem.is_file(file)
        filesystem.remove(file)

# A PNG of two colors side by side, `width` by `height` pixels.
private function halves(width: integer, height: integer) -> Array<byte>
    canvas = graphics.canvas(width, height)
    canvas.fill_rectangle(0, 0, width / 2, height, graphics.rgb(200, 30, 20))
    canvas.fill_rectangle(width / 2, 0, width - width / 2, height, graphics.rgb(20, 40, 210))
    return canvas.png()

test "images sent are judged by their header first"
    assert(problem([]) == "Choose a picture first.")
    assert(problem(halves(64, 32)) == "")
    assert(strings.contains(problem(strings.bytes("<svg xmlns=\"http://www.w3.org/2000/svg\"></svg>")), "not a PNG or JPEG"))
    # A PNG's header that claims 10000 by 10000 pixels is refused undecoded.
    huge: Array<byte> = [137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82, 0, 0, 39, 16, 0, 0, 39, 16, 8, 6, 0, 0, 0]
    assert(strings.contains(problem(huge), "too large"))

test "a picture is the middle square of its image, at its size"
    kept = graphics.decode_image(made(halves(64, 32)))
    assert(kept.width == SIDE and kept.height == SIDE)
    assert(kept.pixel(60, 128) == graphics.rgb(200, 30, 20) and kept.pixel(196, 128) == graphics.rgb(20, 40, 210))
    tall = graphics.decode_image(made_apart(halves(20, 60)))
    assert(tall.width == SIDE and tall.pixel(10, 10) == graphics.rgb(200, 30, 20))
