##
Accounts and what shows who holds one: a password, kept as
`crypto.hash_password` makes it, for the registry's pages; and tokens,
for `sayon` on a computer, each shown once, when it is made, and kept as
its SHA-256. And who owns each package. All of it is JSON in the
registry's data folder, each file written whole (src/files.sayon).
##

crypto = import("standard/crypto.sayon")
filesystem = import("standard/filesystem.sayon")
io = import("standard/io.sayon")
json = import("standard/json.sayon")
strings = import("standard/strings.sayon")
threads = import("standard/threads.sayon")
time = import("standard/time.sayon")
files = import("src/web/files.sayon")

##
An account: when it was made; its password, unless the operator made it
and no one has chosen one yet; its email address; whether it may publish
and post (`verified`: its email was verified, or the operator made it, or
it was made before accounts had email, which leaves it nothing); its
role, "admin" or "moderator", or nothing for anyone else; a few words
about its owner; whether its owner is mailed news, such as replies
(nothing for yes); until when moderators keep it from posting, in
seconds since 1970; and the version of its picture
(src/accounts/pictures.sayon), or nothing for none.
##
type Account = [created: string, password: string or nothing, email: string or nothing, verified: boolean or nothing, role: string or nothing, bio: string or nothing, notify: boolean or nothing, suspended: integer or nothing, picture: string or nothing]

##
A token: the account it belongs to, what it is for, such as the computer
`sayon login` ran on, and when it was made and last used.
##
type Token = [account: string, name: string, created: string, used: string or nothing]

# A new account, made now.
function new_account(own password: string or nothing, own email: string or nothing, verified: boolean) -> Account
    return Account(created = time.format(time.now()), password = password, email = email, verified = verified, role = nothing, bio = nothing, notify = nothing, suspended = nothing, picture = nothing)

##
Whether an account may publish packages and post: unless it is waiting
for its email to be verified.
##
function may_publish(account: Account) -> boolean
    return account.verified != false

##
Whether an account looks after the forum: its moderators, and the
website's admins, who also appoint the moderators.
##
function moderates(account: Account) -> boolean
    return account.role == "moderator" or account.role == "admin"

function is_admin(account: Account) -> boolean
    return account.role == "admin"

##
Until when moderators keep an account from posting, in seconds since
1970, or nothing when it may post.
##
function suspended_until(account: Account, now: integer) -> integer or nothing
    until = clone(account.suspended)
    if until != nothing and until > now
        return until
    return nothing

# Whether an account was made in the last week, when it posts less.
function is_new(account: Account, now: integer) -> boolean
    return account.created > time.format(time.from_unix(now - 7 * 86400))

# The most characters an email address, and a bio, have.
constant LONGEST_EMAIL = 254
constant LONGEST_BIO = 160

##
What is wrong with text as an email address, or nothing: it is one
address, `name@domain.tld`, without spaces or what a mail's header could
take for more.
##
function email_problem(text: string) -> string or nothing
    if text == ""
        return "Give an email address, where the website can send you a link to choose a new password."
    if length(text) > LONGEST_EMAIL
        return "An email address has {LONGEST_EMAIL} characters at most."
    for symbol in [" ", ",", ";", "<", ">", "\"", "(", ")", "[", "]", "\\", "\r", "\n", "\t"]
        if strings.contains(text, symbol)
            return "That is not an email address, such as ada@example.com."
    parts = strings.split(text, "@")
    if length(parts) != 2 or parts[0] == "" or parts[1] == ""
        return "That is not an email address, such as ada@example.com."
    domain = clone(parts[1])
    if not strings.contains(domain, ".") or strings.starts_with(domain, ".") or strings.ends_with(domain, ".") or strings.contains(domain, "..")
        return "That is not an email address, such as ada@example.com."
    return nothing

# The account an email address belongs to, or nothing.
function with_email(all: Dict<string, Account>, email: string) -> string or nothing
    for name, account in all
        if account.email == email
            return clone(name)
    return nothing

# How long a password is, in characters.
constant SHORTEST_PASSWORD = 12
constant LONGEST_PASSWORD = 256

# What the operator's tokens are called.
constant OPERATOR = "made by the registry's operator"

function accounts(data: string) -> Dict<string, Account>
    file = filesystem.join(data, "accounts.json")
    if not filesystem.is_file(file)
        return []
    return json.decode(io.read_file(file))

function save_accounts(data: string, all: Dict<string, Account>)
    files.save_text(filesystem.join(data, "accounts.json"), json.encode_value(all))

# The tokens, by the SHA-256 of each, in hexadecimal.
function tokens(data: string) -> Dict<string, Token>
    file = filesystem.join(data, "tokens.json")
    if not filesystem.is_file(file)
        return []
    return json.decode(io.read_file(file))

function save_tokens(data: string, all: Dict<string, Token>)
    files.save_text(filesystem.join(data, "tokens.json"), json.encode_value(all))

# Who owns each package: the account that published it first.
function owners(data: string) -> Dict<string, string>
    file = filesystem.join(data, "owners.json")
    if not filesystem.is_file(file)
        return []
    return json.decode(io.read_file(file))

function save_owners(data: string, all: Dict<string, string>)
    files.save_text(filesystem.join(data, "owners.json"), json.encode_value(all))

# The packages an account owns, by name.
function packages_of(owners: Dict<string, string>, account: string) -> Array<string>
    out: Array<string> = []
    for name, owner in owners
        if owner == account
            push(out, clone(name))
    return out

# The SHA-256 of a secret, in hexadecimal, as the registry keeps secrets.
function hash(secret: string) -> string
    return crypto.hex(crypto.sha256(strings.bytes(secret)))

# A new token: 32 random bytes from the system's secure source.
function new_token() -> string
    return "sayon_" + crypto.hex(crypto.random_bytes(32))

# A token's short name on the account's page: the start of its hash.
function token_id(key: string) -> string
    return strings.slice(key, 0, 16)

# The account a token belongs to.
function account_for(all: Dict<string, Token>, token: string) -> string or nothing
    key = hash(token)
    if haskey(all, key)
        return clone(all[key].account)
    return nothing

# Gives an account a new token for `name`: the token.
function add_token(update all: Dict<string, Token>, account: string, name: string) -> string
    token = new_token()
    all[hash(token)] = Token(account = clone(account), name = clone(name), created = time.format(time.now()), used = nothing)
    return token

##
Takes away an account's tokens, every one, or the one whose id is `only`;
whether it took any.
##
function remove_tokens(update all: Dict<string, Token>, account: string, only: string or nothing = nothing) -> boolean
    gone: Array<string> = []
    for key, token in all
        if token.account == account and (only == nothing or token_id(key) == only)
            push(gone, clone(key))
    for key in gone
        remove(all, key)
    return length(gone) > 0

##
Makes an account for the registry's operator, or with `replace` takes
away an existing one's tokens, and gives it a new token: the token, or
nothing when the account exists and is not to be replaced.
##
function make(update all: Dict<string, Account>, update tokens: Dict<string, Token>, name: string, replace: boolean) -> string or nothing
    if haskey(all, name)
        if not replace
            return nothing
        remove_tokens(tokens, name)
    else
        all[clone(name)] = new_account(nothing, nothing, true)
    return add_token(tokens, name, OPERATOR)

# What is wrong with a password for an account, or nothing.
function password_problem(name: string, password: string) -> string or nothing
    if length(password) < SHORTEST_PASSWORD
        return "Use at least {SHORTEST_PASSWORD} characters. A few words in a row make a password that is long and easy to remember."
    if length(password) > LONGEST_PASSWORD
        return "Use at most {LONGEST_PASSWORD} characters."
    lowered = strings.lower(password)
    if lowered == name or length(name) >= 4 and strings.contains(lowered, name)
        return "Choose a password that does not hold the account's name."
    return nothing

##
Whether a password is the account's own. The check takes a second on
purpose, so it runs on a thread of its own, and the website answers
others meanwhile.
##
function password_is(account: Account, password: string) -> boolean
    stored = clone(account.password)
    if stored == nothing
        return false
    kept: string = stored
    given = clone(password)
    checking = threads.spawn_parallel(function() -> boolean
        return crypto.check_password(given, kept)
    )
    return threads.join(checking)

##
A password made safe to keep, as `crypto.hash_password` makes it, on a
thread of its own, for the same reason.
##
function hash_password(password: string) -> string
    given = clone(password)
    hashing = threads.spawn_parallel(function() -> string
        return crypto.hash_password(given)
    )
    return threads.join(hashing)

# An account as an older registry kept it: with one token, by its hash.
private type Former = [created: string, token: string or nothing]

# Moves the tokens of an older registry's accounts.json to tokens.json.
function upgrade(data: string)
    file = filesystem.join(data, "accounts.json")
    if not filesystem.is_file(file)
        return
    former: Dict<string, Former> = json.decode(io.read_file(file))
    all = tokens(data)
    moved = false
    for name, account in former
        token = clone(account.token)
        if token != nothing
            all[token] = Token(account = clone(name), name = clone(OPERATOR), created = clone(account.created), used = nothing)
            moved = true
    if moved
        ##
        The tokens go first: a crash before the accounts are written
        leaves them in both, and upgrading again moves the same ones.
        ##
        save_tokens(data, all)
        save_accounts(data, accounts(data))

test "a token is kept only as its hash, and finds its account"
    all: Dict<string, Account> = []
    kept: Dict<string, Token> = []
    token = make(all, kept, "ada", false)
    assert(token != nothing)
    if token != nothing
        assert(strings.starts_with(token, "sayon_") and length(token) == 70)
        assert(haskey(kept, hash(token)) and not haskey(kept, token))
        assert(account_for(kept, token) == "ada")
        assert(account_for(kept, token + "x") == nothing)
        assert(make(all, kept, "ada", false) == nothing)
        other = add_token(kept, "ada", "laptop")
        again = make(all, kept, "ada", true)
        assert(again != nothing and account_for(kept, token) == nothing and account_for(kept, other) == nothing)
        assert(length(kept) == 1)

test "a token is taken away by its id"
    kept: Dict<string, Token> = []
    first = add_token(kept, "ada", "laptop")
    second = add_token(kept, "ada", "desktop")
    assert(not remove_tokens(kept, "bo", token_id(hash(first))))
    assert(remove_tokens(kept, "ada", token_id(hash(first))))
    assert(account_for(kept, first) == nothing and account_for(kept, second) == "ada")

test "passwords are long, and not the account's name"
    assert(password_problem("ada", "short") != nothing)
    assert(password_problem("lovelace", "ada lovelace 1815") != nothing)
    assert(password_problem("ada", "ada") != nothing and password_problem("ada", "ada lovelace 1815") == nothing)
    assert(password_problem("ada", "correct horse battery staple") == nothing)
    account = new_account(crypto.hash_password("correct horse battery staple"), nothing, true)
    assert(password_is(account, "correct horse battery staple"))
    assert(not password_is(account, "correct horse battery stable"))
    assert(not password_is(new_account(nothing, nothing, true), ""))

test "email addresses are one address each"
    for good in ["ada@example.com", "a.b+c@mail.example.org"]
        assert(email_problem(good) == nothing, good)
    for bad in ["", "ada", "ada@", "@example.com", "ada@example", "ada@@example.com", "a da@example.com", "ada@example.com\r\nBcc: x@y.z", "ada@.com", "ada@example..com"]
        assert(email_problem(bad) != nothing, bad)
    all: Dict<string, Account> = ["ada" = new_account(nothing, "ada@example.com", true)]
    assert(with_email(all, "ada@example.com") == "ada" and with_email(all, "bo@example.com") == nothing)
    assert(may_publish(all["ada"]) and not may_publish(new_account(nothing, "bo@example.com", false)))
