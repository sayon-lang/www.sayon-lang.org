# HTTP/1.1 as the registry speaks it: a request read whole, with its
# headers and body, and a response written whole, one of each for every
# connection.

json = import("standard/json.sayon")
network = import("standard/network.sayon")
strings = import("standard/strings.sayon")

# The most a request's body may hold: an archive, and a little more.
constant LARGEST = 10486784

# A request: its method, its target as it came, and the target's path and
# query; its headers, by lowercase names; its body; and the address of the
# computer that sent it.
type Request = [method: string, target: string, path: string, query: Dict<string, string>, headers: Dict<string, string>, body: Array<byte>, client: string]

type Response = [status: integer, kind: string, headers: Dict<string, string>, body: Array<byte>]

# `{"error": ...}`, as the registry refuses a request.
type Refusal = [error: string]

function reason(status: integer) -> string
    match status
        case 200
            return "OK"
        case 201
            return "Created"
        case 303
            return "See Other"
        case 308
            return "Permanent Redirect"
        case 400
            return "Bad Request"
        case 401
            return "Unauthorized"
        case 403
            return "Forbidden"
        case 404
            return "Not Found"
        case 405
            return "Method Not Allowed"
        case 409
            return "Conflict"
        case 410
            return "Gone"
        case 413
            return "Content Too Large"
        case 429
            return "Too Many Requests"
        case _
            return "Internal Server Error"

function respond(status: integer, kind: string, own body: Array<byte>) -> Response
    return Response(status = status, kind = clone(kind), headers = [], body = body)

function text(status: integer, kind: string, content: string) -> Response
    return respond(status, kind, strings.bytes(content))

function json_text(status: integer, content: string) -> Response
    return text(status, "application/json", content)

function refuse(status: integer, message: string) -> Response
    return json_text(status, json.encode_value(Refusal(error = clone(message))))

# What a page is sent with: it may not be put in another site's frame, run
# any script (the website has none), or be kept, since it shows who is
# signed in.
constant PAGE_POLICY = "default-src 'self'; script-src 'none'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"

# A page of HTML.
function page(status: integer, content: string) -> Response
    response = text(status, "text/html; charset=utf-8", content)
    response.headers["Content-Security-Policy"] = clone(PAGE_POLICY)
    response.headers["X-Frame-Options"] = "DENY"
    response.headers["X-Content-Type-Options"] = "nosniff"
    response.headers["Referrer-Policy"] = "same-origin"
    response.headers["Cache-Control"] = "no-store"
    return response

# Sends the browser to another address, with GET: after a form, so that
# going back or reloading never sends it twice.
function redirect(location: string, status: integer = 303) -> Response
    response = text(status, "text/plain; charset=utf-8", "See " + location)
    response.headers["Location"] = clone(location)
    response.headers["Cache-Control"] = "no-store"
    return response

private function hex_value(digit: string) -> integer or nothing
    found = strings.find("0123456789abcdef", strings.lower(digit))
    if found == nothing or length(digit) != 1
        return nothing
    return found

# A part of an address with `%XX` and `+` decoded.
function decode(text: string) -> string
    characters = strings.characters(strings.replace(text, "+", " "))
    bytes: Array<byte> = []
    index = 0
    while index < length(characters)
        if characters[index] == "%" and index + 2 < length(characters)
            high = hex_value(characters[index + 1])
            low = hex_value(characters[index + 2])
            if high != nothing and low != nothing
                push(bytes, byte(high * 16 + low))
                index += 3
                continue
        for value in strings.bytes(characters[index])
            push(bytes, value)
        index += 1
    return strings.from_bytes_lossy(bytes)

private constant HEX = "0123456789ABCDEF"

# Text made fit to put in a part of an address: each byte but letters,
# digits, and `-._~` written as `%XX`.
function encode(text: string) -> string
    out: Array<string> = []
    for value in strings.bytes(text)
        number = integer(value)
        plain = number >= 48 and number <= 57 or number >= 65 and number <= 90 or number >= 97 and number <= 122
        if plain or number == 45 or number == 46 or number == 95 or number == 126
            push(out, strings.character(number))
        else
            push(out, "%" + HEX[number / 16] + HEX[number % 16])
    return strings.join(out, "")

function parse_query(text: string) -> Dict<string, string>
    out: Dict<string, string> = []
    for part in strings.split(text, "&")
        if part == ""
            continue
        equals = strings.find(part, "=")
        if equals == nothing
            out[decode(part)] = ""
        else
            out[decode(strings.slice(part, 0, equals))] = decode(strings.slice(part, equals + 1, length(part)))
    return out

# The next request, a response refusing it, or nothing when the connection
# ends first.
function read(update connection: network.Connection) -> Request or Response or nothing
    line = connection.read_line()
    if line == nothing
        return nothing
    parts = strings.split(strings.trim(line), " ")
    if length(parts) != 3
        return refuse(400, "this is not an HTTP request")
    headers: Dict<string, string> = []
    while true
        field = connection.read_line()
        if field == nothing or strings.trim(field) == ""
            break
        colon = strings.find(field, ":")
        if colon != nothing
            headers[strings.lower(strings.trim(strings.slice(field, 0, colon)))] = strings.trim(strings.slice(field, colon + 1, length(field)))
    size = 0
    if haskey(headers, "content-length")
        given = tonumber(headers["content-length"])
        if typeof(given) != "integer" or given < 0
            return refuse(400, "the request's length is not a number")
        size = given
    if size > LARGEST
        return refuse(413, "a package holds 10 MiB at most")
    # A body arrives in parts, as the network carries it, so it is read until
    # it is whole.
    body: Array<byte> = []
    if size > 0
        body = connection.read_exactly(size)
        if length(body) != size
            return refuse(400, "the request ended before its body did")
    target = clone(parts[1])
    path = clone(target)
    query: Dict<string, string> = []
    mark = strings.find(target, "?")
    if mark != nothing
        path = strings.slice(target, 0, mark)
        query = parse_query(strings.slice(target, mark + 1, length(target)))
    return Request(method = clone(parts[0]), target = target, path = path, query = query, headers = headers, body = body, client = connection.peer_address().host)

# A cookie the request carries, or nothing.
function cookie(request: Request, name: string) -> string or nothing
    if not haskey(request.headers, "cookie")
        return nothing
    for part in strings.split(request.headers["cookie"], ";")
        equals = strings.find(part, "=")
        if equals != nothing
            if strings.trim(strings.slice(part, 0, equals)) == name
                return strings.trim(strings.slice(part, equals + 1, length(part)))
    return nothing

# The fields of a form, as a browser sends them.
function form(request: Request) -> Dict<string, string>
    content = try strings.from_bytes(request.body)
    if content is error
        return []
    return parse_query(content)

# A part of a form sent as multipart/form-data, as a form with a file is:
# its field's name, the file's name and type as the browser gave them, and
# its bytes.
type Upload = [field: string, file: string, kind: string, bytes: Array<byte>]

# The boundary between the parts of a multipart/form-data body, or "".
private function boundary_of(request: Request) -> string
    if not haskey(request.headers, "content-type")
        return ""
    kind = clone(request.headers["content-type"])
    if not strings.starts_with(strings.lower(kind), "multipart/form-data")
        return ""
    at = strings.find(strings.lower(kind), "boundary=")
    if at == nothing
        return ""
    value = strings.slice(kind, at + 9, length(kind))
    end = strings.find(value, ";")
    if end != nothing
        value = strings.slice(value, 0, end)
    value = strings.trim(value)
    if length(value) >= 2 and strings.starts_with(value, "\"") and strings.ends_with(value, "\"")
        value = strings.slice(value, 1, length(value) - 1)
    return value

# A parameter of a part's Content-Disposition, such as `name="picture"`.
private function parameter(head: string, name: string) -> string
    at = strings.find(head, "; {name}=\"")
    if at == nothing
        return ""
    value = strings.slice(head, at + length(name) + 4, length(head))
    end = strings.find(value, "\"")
    if end == nothing
        return ""
    return strings.slice(value, 0, end)

# A header of a part, by its name in lowercase, or "".
private function part_header(head: string, name: string) -> string
    for line in strings.split(head, "\r\n")
        colon = strings.find(line, ":")
        if colon != nothing and strings.lower(strings.trim(strings.slice(line, 0, colon))) == name
            return strings.trim(strings.slice(line, colon + 1, length(line)))
    return ""

# The parts of a form sent as multipart/form-data, in order. The body is
# read as Latin-1, a character for each byte, so that it is searched as
# text and each part's bytes come back as they were sent.
function form_parts(request: Request) -> Array<Upload>
    out: Array<Upload> = []
    boundary = boundary_of(request)
    if boundary == ""
        return out
    latin = strings.decode(request.body, "latin-1")
    delimiter = "--" + boundary
    start = strings.find(latin, delimiter)
    if start == nothing
        return out
    rest = strings.slice(latin, start + length(delimiter), length(latin))
    while strings.starts_with(rest, "\r\n")
        head_end = strings.find(rest, "\r\n\r\n")
        if head_end == nothing
            break
        head = strings.slice(rest, 2, head_end)
        rest = strings.slice(rest, head_end + 4, length(rest))
        end = strings.find(rest, "\r\n" + delimiter)
        if end == nothing
            break
        content = strings.slice(rest, 0, end)
        push(out, Upload(field = parameter(head, "name"), file = parameter(head, "filename"), kind = part_header(head, "content-type"), bytes = strings.encode(content, "latin-1")))
        rest = strings.slice(rest, end + 2 + length(delimiter), length(rest))
    return out

# The first part a form sent for a field, or nothing.
function upload(request: Request, field: string) -> Upload or nothing
    for part in form_parts(request)
        if part.field == field
            return clone(part)
    return nothing

# The token of `Authorization: Bearer <token>`.
function bearer(request: Request) -> string or nothing
    if not haskey(request.headers, "authorization")
        return nothing
    value = strings.trim(request.headers["authorization"])
    if strings.starts_with(strings.lower(value), "bearer ")
        token = strings.trim(strings.slice(value, 7, length(value)))
        if token != "" and not strings.contains(token, " ")
            return token
    return nothing

# Writes a response, with its body unless the request was HEAD, and
# finishes sending, since a connection carries one response: the other
# side reads to its end at once, before the connection is let go.
function write(update connection: network.Connection, response: Response, with_body: boolean = true)
    connection.write("HTTP/1.1 {response.status} {reason(response.status)}\r\n")
    connection.write("Content-Type: {response.kind}\r\n")
    connection.write("Content-Length: {length(response.body)}\r\n")
    for name, value in response.headers
        connection.write("{name}: {value}\r\n")
    connection.write("Connection: close\r\n\r\n")
    if with_body
        connection.write_bytes(response.body)
    connection.flush()
    connection.finish_sending()

test "addresses are decoded"
    assert(decode("json+parser%2Fa%C3%A9") == "json parser/aé")
    query = parse_query("q=text%20tools&limit=5&flag")
    assert(query["q"] == "text tools" and query["limit"] == "5" and query["flag"] == "")
    assert(encode("/login/BCDF-GHJK?a=b c") == "%2Flogin%2FBCDF-GHJK%3Fa%3Db%20c")
    assert(decode(encode("aé /&")) == "aé /&")

test "cookies are found by name"
    headers: Dict<string, string> = ["cookie" = "theme=dark; sayon_session=ab12 ;other=x=y"]
    request = Request(method = "GET", target = "/", path = "/", query = [], headers = headers, body = [], client = "127.0.0.1")
    assert(cookie(request, "sayon_session") == "ab12" and cookie(request, "other") == "x=y")
    assert(cookie(request, "session") == nothing)

test "the parts of a form with a file come back as they were sent"
    file: Array<byte> = [255, 216, 0, 13, 10, 45, 45, 128, 200, 13]
    body = strings.bytes("--XyZ\r\nContent-Disposition: form-data; name=\"note\"\r\n\r\nhello\r\n--XyZ\r\nContent-Disposition: form-data; name=\"picture\"; filename=\"me.jpg\"\r\nContent-Type: image/jpeg\r\n\r\n")
    for value in file
        push(body, value)
    for value in strings.bytes("\r\n--XyZ--\r\n")
        push(body, value)
    headers: Dict<string, string> = ["content-type" = "multipart/form-data; boundary=\"XyZ\""]
    request = Request(method = "POST", target = "/", path = "/", query = [], headers = headers, body = body, client = "127.0.0.1")
    found = form_parts(request)
    assert(length(found) == 2 and found[0].field == "note" and strings.from_bytes(found[0].bytes) == "hello" and found[0].file == "")
    assert(found[1].field == "picture" and found[1].file == "me.jpg" and found[1].kind == "image/jpeg" and found[1].bytes == file)
    assert(upload(request, "picture") != nothing and upload(request, "missing") == nothing)
