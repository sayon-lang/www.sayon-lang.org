##
Writing the registry's files whole: each through a temporary file beside
it, renamed over it once written, so that no file is ever half written,
not even by a crash or a power cut part way.
##

filesystem = import("standard/filesystem.sayon")
io = import("standard/io.sayon")

# Writes text to a file through a temporary one.
function save_text(path: string, text: string)
    temporary = path + ".tmp"
    io.write_file(temporary, text)
    filesystem.rename(temporary, path)

# Writes bytes to a file through a temporary one.
function save_bytes(path: string, bytes: Array<byte>)
    temporary = path + ".tmp"
    io.write_file_bytes(temporary, bytes)
    filesystem.rename(temporary, path)
