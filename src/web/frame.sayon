# The frame of every page of Sayon's website: the head, the bar with the
# site's parts, and the footer, in the look of static/style.css. No script
# runs on the website: the theme's switch is a form, and the website
# remembers the theme chosen, in a cookie, and puts it on each page.

crypto = import("standard/crypto.sayon")
filesystem = import("standard/filesystem.sayon")
io = import("standard/io.sayon")
strings = import("standard/strings.sayon")
html = import("src/web/html.sayon")

constant GITHUB = "https://github.com/sayon-lang"

# The version of the stylesheet, which its address carries, so that a
# browser keeps it until it changes.
constant ASSETS = assets_version()

# Icons drawn in the text's color.
constant SEARCH_ICON = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4.2-4.2\"/></svg>"
constant MOON_ICON = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z\"/></svg>"
constant SUN_ICON = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4\"/></svg>"

# The start of the SHA-256 of `static/style.css`, or "0" when the website
# runs elsewhere than its folder.
function assets_version() -> string
    if not filesystem.is_file("static/style.css")
        return "0"
    return strings.slice(crypto.hex(crypto.sha256(io.read_file_bytes("static/style.css"))), 0, 12)

# A page: its title and description; the part of the site it is in, as
# `sections` names them, or "" for none; what the bar holds after the
# parts' links, before the link to GitHub and the theme's switch, as HTML;
# the theme chosen, "light" or "dark", or "" for the system's; and where
# the page is, for the switch to come back to.
type Page = [title: string, description: string, section: string, tools: Array<string>, theme: string, at: string]

# The theme's switch: a form of two buttons, one for each theme, of which
# the stylesheet shows the one for the theme not shown.
private function theme_switch(at: string) -> string
    back = "<input type=\"hidden\" name=\"back\" value=\"{html.escape(at)}\">"
    dark = "<button class=\"icon-button to-dark\" type=\"submit\" name=\"theme\" value=\"dark\" aria-label=\"Use the dark theme\" title=\"Use the dark theme\">{MOON_ICON}</button>"
    light = "<button class=\"icon-button to-light\" type=\"submit\" name=\"theme\" value=\"light\" aria-label=\"Use the light theme\" title=\"Use the light theme\">{SUN_ICON}</button>"
    return "<form class=\"theme-switch\" method=\"post\" action=\"/theme\">{back}{dark}{light}</form>"

# A part of the site, as the bar and the footer link it.
type Section = [key: string, label: string, address: string]

function sections() -> Array<Section>
    return [
        Section(key = "docs", label = "Docs", address = "/docs"),
        Section(key = "packages", label = "Packages", address = "/packages"),
        Section(key = "community", label = "Community", address = "/community")
    ]

private function brand() -> string
    return "<a class=\"brand\" href=\"/\"><img src=\"/images/logo.svg\" alt=\"\" width=\"28\" height=\"28\">Sayon</a>"

# The page's start: its head, the link past the bar, and the bar.
function top(page: Page) -> Array<string>
    out: Array<string> = []
    push(out, "<!doctype html>")
    chosen = ""
    if page.theme == "light" or page.theme == "dark"
        chosen = " data-theme=\"{page.theme}\""
    push(out, "<html lang=\"en\"{chosen}>")
    push(out, "<head>")
    push(out, "  <meta charset=\"utf-8\">")
    push(out, "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
    push(out, "  <title>{html.text(page.title)}</title>")
    if page.description != ""
        push(out, "  <meta name=\"description\" content=\"{html.escape(page.description)}\">")
    # The browser's own color: the theme chosen's, or the system's.
    if page.theme == "light"
        push(out, "  <meta name=\"theme-color\" content=\"#ffffff\">")
    elseif page.theme == "dark"
        push(out, "  <meta name=\"theme-color\" content=\"#12151b\">")
    else
        push(out, "  <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">")
        push(out, "  <meta name=\"theme-color\" content=\"#12151b\" media=\"(prefers-color-scheme: dark)\">")
    push(out, "  <link rel=\"icon\" href=\"/favicon.ico\" sizes=\"any\">")
    push(out, "  <link rel=\"icon\" href=\"/images/logo.svg\" type=\"image/svg+xml\">")
    push(out, "  <link rel=\"apple-touch-icon\" href=\"/images/icon-256.png\">")
    push(out, "  <link rel=\"stylesheet\" href=\"/style.css?v={ASSETS}\">")
    push(out, "</head>")
    push(out, "<body>")
    push(out, "  <a class=\"skip\" href=\"#main\">Skip to the content</a>")
    push(out, "  <header class=\"bar\">")
    push(out, "    <div class=\"bar-inner\">")
    push(out, "      " + brand())
    push(out, "      <nav class=\"nav\" aria-label=\"Sayon\">")
    for section in sections()
        current = ""
        if section.key == page.section
            current = " aria-current=\"page\""
        push(out, "        <a href=\"{section.address}\"{current}>{html.text(section.label)}</a>")
    push(out, "      </nav>")
    push(out, "      <div class=\"tools\">")
    for line in page.tools
        push(out, "        " + line)
    push(out, "        <a class=\"tool-link hide-small\" href=\"{GITHUB}\">GitHub</a>")
    push(out, "        " + theme_switch(page.at))
    push(out, "      </div>")
    push(out, "    </div>")
    push(out, "  </header>")
    return out

# The page's end: the footer.
function bottom() -> Array<string>
    out: Array<string> = []
    push(out, "  <footer class=\"foot\">")
    push(out, "    <div class=\"foot-inner\">")
    push(out, "      <div class=\"foot-brand\">")
    push(out, "        " + brand())
    push(out, "        <p>Programming made easy. Safety made automatic.</p>")
    push(out, "      </div>")
    push(out, "      <nav aria-label=\"The website\">")
    push(out, "        <h2>Sayon</h2>")
    push(out, "        <ul>")
    for section in sections()
        push(out, "          <li><a href=\"{section.address}\">{html.text(section.label)}</a></li>")
    push(out, "          <li><a href=\"/account\">Your account</a></li>")
    push(out, "        </ul>")
    push(out, "      </nav>")
    push(out, "      <nav aria-label=\"Source\">")
    push(out, "        <h2>Source</h2>")
    push(out, "        <ul>")
    push(out, "          <li><a href=\"{GITHUB}/sayon\">The language</a></li>")
    push(out, "          <li><a href=\"{GITHUB}/sayon-vscode\">The VS Code extension</a></li>")
    push(out, "          <li><a href=\"{GITHUB}/www.sayon-lang.org\">This website</a></li>")
    push(out, "        </ul>")
    push(out, "      </nav>")
    push(out, "      <nav aria-label=\"License\">")
    push(out, "        <h2>License</h2>")
    push(out, "        <ul>")
    push(out, "          <li><a href=\"{GITHUB}/sayon/blob/main/LICENSE\">Apache 2.0 with LLVM's exception</a></li>")
    push(out, "        </ul>")
    push(out, "      </nav>")
    push(out, "      <p class=\"fine\">This website is a Sayon program, <a href=\"{GITHUB}/www.sayon-lang.org\">www.sayon-lang.org</a>, and every package version it holds is listed in its public index, <a href=\"{GITHUB}/packages-index\">packages-index</a>.</p>")
    push(out, "    </div>")
    push(out, "  </footer>")
    push(out, "</body>")
    push(out, "</html>")
    push(out, "")
    return out
