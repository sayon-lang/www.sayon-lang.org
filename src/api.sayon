# The registry's API (PROTOCOL.md), under `/api/v1`, and its index, under
# `/index`: what `sayon publish`, `login`, `logout`, `search`, and `install`
# ask.

crypto = import("standard/crypto.sayon")
filesystem = import("standard/filesystem.sayon")
io = import("standard/io.sayon")
json = import("standard/json.sayon")
strings = import("standard/strings.sayon")
time = import("standard/time.sayon")
accounts = import("src/accounts.sayon")
archive = import("src/archive.sayon")
files = import("src/files.sayon")
http = import("src/http.sayon")
index = import("src/index.sayon")
logins = import("src/logins.sayon")
manifest = import("src/manifest.sayon")
registry = import("src/registry.sayon")
semver = import("src/semver.sayon")

constant PROTOCOL = 1

type Protocol = [protocol: integer]
type Me = [name: string]
type NewAccount = [name: string, replace: boolean or nothing]
type Made = [name: string, token: string]
type Published = [name: string, version: string, digest: string]
type Found = [packages: Array<registry.Summary>]

# A sign-in `sayon login` starts, for the computer it names, and what it is
# given: the secret it asks with, the code its user checks, how often to
# ask, and for how long, in seconds.
type LoginAsked = [machine: string or nothing]
type LoginStarted = [secret: string, code: string, interval: integer, expires: integer]
type LoginPolled = [secret: string]

# How a sign-in stands: "waiting", "denied", or "approved", with the account
# and its new token.
type LoginState = [status: string, account: string or nothing, token: string or nothing]

type Revoked = [revoked: boolean]

# The index's `config.json`: where to publish, and where archives are.
type Config = [protocol: integer, api: string, download: string]

# The parts of a path between its `/`s.
function parts(path: string) -> Array<string>
    out: Array<string> = []
    for part in strings.split(path, "/")
        if part != ""
            push(out, clone(part))
    return out

# The account a request's token belongs to, or the refusal. The token is
# marked as used, for its account's page.
private function authenticate(request: http.Request, state: registry.State) -> string or http.Response
    token = http.bearer(request)
    if token == nothing
        return http.refuse(401, "this needs an account's token: run `sayon login` first")
    all = accounts.tokens(state.data)
    key = accounts.hash(token)
    if not haskey(all, key)
        return http.refuse(401, "the token is not one this registry knows: run `sayon login` again")
    all[key].used = time.format(time.now())
    accounts.save_tokens(state.data, all)
    return clone(all[key].account)

# The operator makes an account, or gives one a new token.
private function make_account(request: http.Request, state: registry.State) -> http.Response
    token = http.bearer(request)
    if token == nothing or not crypto.same(strings.bytes(token), strings.bytes(state.admin))
        return http.refuse(403, "only the registry's operator makes accounts")
    text = try strings.from_bytes(request.body)
    if text is error
        return http.refuse(400, "the request is not JSON")
    asked = try json.decode<NewAccount>(text)
    if asked is error
        return http.refuse(400, "the request is not {{\"name\": ...}}")
    if not index.valid_name(asked.name)
        return http.refuse(400, "an account's name is lowercase letters, digits, and `_`, starting with a letter")
    all = accounts.accounts(state.data)
    kept = accounts.tokens(state.data)
    replace = asked.replace == true
    existed = haskey(all, asked.name)
    made = accounts.make(all, kept, asked.name, replace)
    if made == nothing
        return http.refuse(409, "the account `{asked.name}` already exists")
    accounts.save_tokens(state.data, kept)
    accounts.save_accounts(state.data, all)
    status = 201
    if existed
        status = 200
    return http.json_text(status, json.encode_value(Made(name = clone(asked.name), token = made)))

# Publishes a version: the archive, checked, with its manifest naming the
# package and the version, by the package's owner or, for a new package, by
# whoever publishes it first. A version never changes.
private function publish(request: http.Request, state: registry.State, name: string, version: string) -> http.Response
    account = authenticate(request, state)
    if typeof(account) != "string"
        return account
    if not index.valid_name(name)
        return http.refuse(400, "`{name}` is not a package name")
    if semver.parse(version) == nothing
        return http.refuse(400, "`{version}` is not a version, such as 1.0.0")
    if length(request.body) > archive.LARGEST
        return http.refuse(413, "a package holds 10 MiB at most")
    held = archive.files(request.body)
    if typeof(held) == "string"
        return http.refuse(400, held)
    text = try archive.manifest_text(request.body, held)
    if text is error
        return http.refuse(400, text.message)
    read = manifest.read(text)
    if typeof(read) == "string"
        return http.refuse(400, read)
    if read.name != name or read.version != version
        return http.refuse(400, "the archive's sayon.toml is {read.name} {read.version}, not {name} {version}")
    # Its dependencies are listed as `sayon` reads them, or no one could
    # install the version.
    for dependency in read.dependencies
        for named in [clone(dependency.alias), clone(dependency.package)]
            if not index.valid_name(named)
                return http.refuse(400, "the archive's sayon.toml has a dependency named \"{named}\", which is not a package name")
        if not semver.valid_range(dependency.requirement)
            return http.refuse(400, "the dependency `{dependency.alias}` asks for \"{dependency.requirement}\", which is not a range of versions")
        from = clone(dependency.registry)
        if from != nothing and not registry.valid_address(from)
            return http.refuse(400, "the dependency `{dependency.alias}` comes from \"{from}\", which is not a registry's address: Sayon reaches registries over HTTPS, or over HTTP on this computer")
    owners = accounts.owners(state.data)
    if haskey(owners, name) and owners[name] != account
        return http.refuse(403, "`{name}` belongs to the account `{owners[name]}`")
    for entry in index.entries(state.index, name)
        if entry.version == version
            return http.refuse(409, "{name} {version} is already published, and versions never change; publish a new version")
    digest = "sha256:" + crypto.hex(crypto.sha256(request.body))
    # The archive goes first, whole, so that no version is ever listed
    # without one. After a crash between the two, the version is not listed,
    # and publishing it again replaces the archive.
    target = registry.archive_path(state, name, version)
    filesystem.create_directory(filesystem.parent(target))
    files.save_bytes(target, request.body)
    entry = index.Entry(name = clone(name), version = clone(version), digest = clone(digest), description = clone(read.description), dependencies = clone(read.dependencies), published = time.format(time.now()))
    index.add(state.index, entry)
    if not haskey(owners, name)
        owners[clone(name)] = clone(account)
        accounts.save_owners(state.data, owners)
    return http.json_text(201, json.encode_value(Published(name = clone(name), version = clone(version), digest = digest)))

private function archive_of(state: registry.State, name: string, version: string) -> http.Response
    if index.valid_name(name)
        for entry in index.entries(state.index, name)
            if entry.version == version
                file = registry.archive_path(state, name, version)
                if filesystem.is_file(file)
                    response = http.respond(200, "application/octet-stream", io.read_file_bytes(file))
                    response.headers["X-Sayon-Digest"] = clone(entry.digest)
                    return response
    return http.refuse(404, "there is no version {version} of `{name}`")

private function search(request: http.Request, state: registry.State) -> http.Response
    query = ""
    if haskey(request.query, "q")
        query = clone(request.query["q"])
    limit = 20
    if haskey(request.query, "limit")
        given = tonumber(request.query["limit"])
        if typeof(given) == "integer" and given >= 1 and given <= 50
            limit = given
    return http.json_text(200, json.encode_value(Found(packages = registry.search(state, query, limit))))

# The index's files, and its `config.json`, which names this registry.
private function index_file(state: registry.State, rest: Array<string>) -> http.Response
    if length(rest) == 1 and rest[0] == "config.json"
        config = Config(protocol = PROTOCOL, api = clone(state.address), download = state.address + "/api/v1/packages/{{name}}/{{version}}/archive")
        return http.json_text(200, json.encode_value(config))
    if length(rest) == 0
        return http.refuse(404, "there is nothing at this address")
    name = clone(rest[length(rest) - 1])
    if not index.valid_name(name) or strings.join(rest, "/") != index.path(name)
        return http.refuse(404, "there is no package `{name}`")
    file = filesystem.join(state.index, index.path(name))
    if not filesystem.is_file(file)
        return http.refuse(404, "there is no package `{name}`")
    return http.text(200, "text/plain; charset=utf-8", io.read_file(file))

# Starts a sign-in for `sayon login`, for the computer the request names.
private function start_login(request: http.Request, state: registry.State) -> http.Response
    machine = "a computer"
    text = try strings.from_bytes(request.body)
    if text is error
        return http.refuse(400, "the request is not JSON")
    if strings.trim(text) != ""
        asked = try json.decode<LoginAsked>(text)
        if asked is error
            return http.refuse(400, "the request is not {{\"machine\": ...}}")
        named = clone(asked.machine)
        if named != nothing
            machine = named
    all = logins.logins(state.data)
    started = logins.start(all, machine)
    logins.save_logins(state.data, all)
    reply = LoginStarted(secret = clone(started.secret), code = clone(started.code), interval = logins.INTERVAL, expires = logins.LASTS)
    return http.json_text(201, json.encode_value(reply))

# Tells `sayon login` how its sign-in stands, and once it is approved gives
# it a new token of the account, once.
private function poll_login(request: http.Request, state: registry.State) -> http.Response
    text = try strings.from_bytes(request.body)
    if text is error
        return http.refuse(400, "the request is not JSON")
    asked = try json.decode<LoginPolled>(text)
    if asked is error
        return http.refuse(400, "the request is not {{\"secret\": ...}}")
    all = logins.logins(state.data)
    key = logins.by_secret(all, asked.secret)
    if key == nothing
        return http.refuse(404, "the sign-in is over: it was finished, or it expired; run `sayon login` again")
    if all[key].denied
        remove(all, key)
        logins.save_logins(state.data, all)
        return http.json_text(200, json.encode_value(LoginState(status = "denied", account = nothing, token = nothing)))
    approved = clone(all[key].account)
    if approved == nothing
        return http.json_text(200, json.encode_value(LoginState(status = "waiting", account = nothing, token = nothing)))
    machine = clone(all[key].machine)
    kept = accounts.tokens(state.data)
    token = accounts.add_token(kept, approved, machine)
    # The sign-in goes first: a crash between the two then loses the token
    # rather than letting the secret take a second one.
    remove(all, key)
    logins.save_logins(state.data, all)
    accounts.save_tokens(state.data, kept)
    return http.json_text(200, json.encode_value(LoginState(status = "approved", account = approved, token = token)))

# Revokes the token a request carries, for `sayon logout`.
private function revoke_current(request: http.Request, state: registry.State) -> http.Response
    token = http.bearer(request)
    if token == nothing
        return http.refuse(401, "this needs the token to revoke")
    all = accounts.tokens(state.data)
    key = accounts.hash(token)
    if not haskey(all, key)
        return http.refuse(401, "the token is not one this registry knows, so there is nothing to revoke")
    remove(all, key)
    accounts.save_tokens(state.data, all)
    return http.json_text(200, json.encode_value(Revoked(revoked = true)))

# Answers a request to `/api/v1` or `/index`.
function answer(request: http.Request, state: registry.State) -> http.Response
    path = parts(request.path)
    if length(path) >= 1 and path[0] == "index"
        if request.method != "GET"
            return http.refuse(405, "the index is read with GET")
        rest: Array<string> = []
        for position in range(1, length(path))
            push(rest, clone(path[position]))
        return index_file(state, rest)
    if length(path) < 2 or path[0] != "api" or path[1] != "v1"
        return http.refuse(404, "there is nothing at this address")
    count = length(path)
    if count == 2 and request.method == "GET"
        return http.json_text(200, json.encode_value(Protocol(protocol = PROTOCOL)))
    if count == 3 and path[2] == "me" and request.method == "GET"
        account = authenticate(request, state)
        if typeof(account) != "string"
            return account
        return http.json_text(200, json.encode_value(Me(name = account)))
    if count == 3 and path[2] == "users" and request.method == "POST"
        return make_account(request, state)
    if count == 3 and path[2] == "logins" and request.method == "POST"
        return start_login(request, state)
    if count == 4 and path[2] == "logins" and path[3] == "poll" and request.method == "POST"
        return poll_login(request, state)
    if count == 4 and path[2] == "tokens" and path[3] == "current" and request.method == "DELETE"
        return revoke_current(request, state)
    if count == 3 and path[2] == "search" and request.method == "GET"
        return search(request, state)
    if count == 5 and path[2] == "packages" and request.method == "PUT"
        return publish(request, state, path[3], path[4])
    if count == 6 and path[2] == "packages" and path[5] == "archive" and request.method == "GET"
        return archive_of(state, path[3], path[4])
    return http.refuse(404, "the registry does not answer this request")
