# The frame of every page of Sayon's websites: the head, the bar with the
# three sites, and the footer, in the look of style.css and site.js.
# www.sayon-lang.org, docs.sayon-lang.org, and packages.sayon-lang.org each
# keep a copy of these three files: change all of them together.

html = import("src/html.sayon")

constant GITHUB = "https://github.com/sayon-lang"

# Icons drawn in the text's color.
constant SEARCH_ICON = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4.2-4.2\"/></svg>"
constant MOON_ICON = "<svg class=\"moon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z\"/></svg>"
constant SUN_ICON = "<svg class=\"sun\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4\"/></svg>"

# A page: its title and description; the site it is on, "www", "docs", or
# "packages"; `root`, what the addresses of the site's own files start
# with: "" for a site of files, "/" for one a server answers; what the bar
# holds before the link to GitHub and the theme's switch, as HTML; and a
# sentence for the footer about how the site is made, as HTML.
type Page = [title: string, description: string, site: string, root: string, tools: Array<string>, colophon: string]

# A site, as the bar and the footer link it.
type Site = [key: string, label: string, address: string]

# The address of the site's first page.
function home(page: Page) -> string
    if page.root == ""
        return "index.html"
    return clone(page.root)

# The three sites: the page's own at its first page and, until the others
# have their domains, their sources on GitHub.
function sites(page: Page) -> Array<Site>
    out = [
        Site(key = "www", label = "Overview", address = GITHUB + "/www.sayon-lang.org"),
        Site(key = "docs", label = "Docs", address = GITHUB + "/docs.sayon-lang.org"),
        Site(key = "packages", label = "Packages", address = GITHUB + "/packages.sayon-lang.org")
    ]
    for position in range(length(out))
        if out[position].key == page.site
            out[position].address = home(page)
    return out

private function brand(page: Page) -> string
    return "<a class=\"brand\" href=\"{html.escape(home(page))}\"><img src=\"{page.root}images/logo.svg\" alt=\"\" width=\"28\" height=\"28\">Sayon</a>"

# The page's start: its head, the link past the bar, and the bar.
function top(page: Page) -> Array<string>
    out: Array<string> = []
    push(out, "<!doctype html>")
    push(out, "<html lang=\"en\">")
    push(out, "<head>")
    push(out, "  <meta charset=\"utf-8\">")
    push(out, "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
    push(out, "  <title>{html.text(page.title)}</title>")
    if page.description != ""
        push(out, "  <meta name=\"description\" content=\"{html.escape(page.description)}\">")
    push(out, "  <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">")
    push(out, "  <meta name=\"theme-color\" content=\"#12151b\" media=\"(prefers-color-scheme: dark)\">")
    push(out, "  <link rel=\"icon\" href=\"{page.root}favicon.ico\" sizes=\"any\">")
    push(out, "  <link rel=\"icon\" href=\"{page.root}images/logo.svg\" type=\"image/svg+xml\">")
    push(out, "  <link rel=\"apple-touch-icon\" href=\"{page.root}images/icon-256.png\">")
    push(out, "  <link rel=\"stylesheet\" href=\"{page.root}style.css\">")
    push(out, "  <script src=\"{page.root}site.js\"></script>")
    push(out, "</head>")
    push(out, "<body>")
    push(out, "  <a class=\"skip\" href=\"#main\">Skip to the content</a>")
    push(out, "  <header class=\"bar\">")
    push(out, "    <div class=\"bar-inner\">")
    push(out, "      " + brand(page))
    push(out, "      <nav class=\"sites\" aria-label=\"Sayon's sites\">")
    for site in sites(page)
        current = ""
        if site.key == page.site
            current = " aria-current=\"page\""
        push(out, "        <a href=\"{html.escape(site.address)}\"{current}>{html.text(site.label)}</a>")
    push(out, "      </nav>")
    push(out, "      <div class=\"tools\">")
    for line in page.tools
        push(out, "        " + line)
    push(out, "        <a class=\"tool-link hide-small\" href=\"{GITHUB}\">GitHub</a>")
    push(out, "        <button class=\"icon-button theme\" type=\"button\" data-theme-switch aria-label=\"Switch the theme\">{MOON_ICON}{SUN_ICON}</button>")
    push(out, "      </div>")
    push(out, "    </div>")
    push(out, "  </header>")
    return out

# The page's end: the footer.
function bottom(page: Page) -> Array<string>
    out: Array<string> = []
    push(out, "  <footer class=\"foot\">")
    push(out, "    <div class=\"foot-inner\">")
    push(out, "      <div class=\"foot-brand\">")
    push(out, "        " + brand(page))
    push(out, "        <p>Programming made easy. Safety made automatic.</p>")
    push(out, "      </div>")
    push(out, "      <nav aria-label=\"Sites\">")
    push(out, "        <h2>Sites</h2>")
    push(out, "        <ul>")
    for site in sites(page)
        push(out, "          <li><a href=\"{html.escape(site.address)}\">{html.text(site.label)}</a></li>")
    push(out, "        </ul>")
    push(out, "      </nav>")
    push(out, "      <nav aria-label=\"Source\">")
    push(out, "        <h2>Source</h2>")
    push(out, "        <ul>")
    push(out, "          <li><a href=\"{GITHUB}/sayon\">The language</a></li>")
    push(out, "          <li><a href=\"{GITHUB}/sayon-vscode\">The VS Code extension</a></li>")
    push(out, "          <li><a href=\"{GITHUB}\">Every repository</a></li>")
    push(out, "        </ul>")
    push(out, "      </nav>")
    push(out, "      <nav aria-label=\"License\">")
    push(out, "        <h2>License</h2>")
    push(out, "        <ul>")
    push(out, "          <li><a href=\"{GITHUB}/sayon/blob/main/LICENSE\">Apache 2.0 with LLVM's exception</a></li>")
    push(out, "        </ul>")
    push(out, "      </nav>")
    push(out, "      <p class=\"fine\">{page.colophon}</p>")
    push(out, "    </div>")
    push(out, "  </footer>")
    push(out, "</body>")
    push(out, "</html>")
    push(out, "")
    return out
