##
What the API and the pages share: where the website keeps its data, the
packages its index holds, and its guides.
##

filesystem = import("standard/filesystem.sayon")
strings = import("standard/strings.sayon")
index = import("src/packages/index.sayon")
docs = import("src/pages/docs.sayon")

##
The website: its data folder (accounts, owners, archives), its index
folder, the address it serves at, the operator's token, and the guides,
made HTML when it starts.
##
type State = [data: string, index: string, address: string, admin: string, guides: docs.Docs]

# A package as a list shows it.
type Summary = [name: string, latest: string, description: string]

# Where a version's archive is kept.
function archive_path(state: State, name: string, version: string) -> string
    return filesystem.join(filesystem.join(filesystem.join(state.data, "archives"), name), version + ".archive")

##
Whether an address can be a registry's, as `sayon` reaches registries:
HTTPS, or plain HTTP to this computer, for a registry run locally.
##
function valid_address(address: string) -> boolean
    for symbol in ["?", "#", " ", "\""]
        if strings.contains(address, symbol)
            return false
    if strings.starts_with(address, "https://")
        rest = strings.slice(address, 8, length(address))
        return rest != "" and not strings.starts_with(rest, "/")
    for local in ["http://localhost", "http://127.0.0.1", "http://[::1]"]
        if strings.starts_with(address, local)
            rest = strings.slice(address, length(local), length(address))
            if rest == "" or strings.starts_with(rest, ":") or strings.starts_with(rest, "/")
                return true
    return false

# Every package, by name.
function summaries(state: State) -> Array<Summary>
    out: Array<Summary> = []
    for name in index.names(state.index)
        latest = index.latest(index.entries(state.index, name))
        if latest != nothing
            push(out, Summary(name = clone(name), latest = clone(latest.version), description = clone(latest.description)))
    return out

##
The packages whose names or descriptions hold the words, an exact name
first, `limit` of them at most.
##
function search(state: State, query: string, limit: integer) -> Array<Summary>
    words = strings.lower(strings.trim(query))
    exact: Array<Summary> = []
    others: Array<Summary> = []
    for summary in summaries(state)
        if summary.name == words
            push(exact, clone(summary))
        elseif strings.contains(summary.name, words) or strings.contains(strings.lower(summary.description), words)
            push(others, clone(summary))
    for summary in others
        push(exact, clone(summary))
    while length(exact) > limit
        pop(exact)
    return exact

test "registries are reached over HTTPS, or over HTTP on this computer"
    for good in ["https://www.sayon-lang.org/index", "http://127.0.0.1:4100/index", "http://localhost", "http://[::1]:80/index"]
        assert(valid_address(good), good)
    for bad in ["http://registry.example.com/index", "http://localhost.example.com", "https://", "https:///index", "ftp://registry.example.com", "https://a.example/index?x", ""]
        assert(not valid_address(bad), bad)
