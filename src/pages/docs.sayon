# The guides, under /docs: the Markdown of `docs`, made HTML once when the
# site starts, and each guide's page around it: the guides beside it; for a
# long page, its sections; and at its end, where to change it and the
# guides before and after it.

filesystem = import("standard/filesystem.sayon")
io = import("standard/io.sayon")
html = import("src/web/html.sayon")
http = import("src/web/http.sayon")
layout = import("src/web/layout.sayon")
markdown = import("src/web/markdown.sayon")

constant SOURCES = "https://github.com/sayon-lang/www.sayon-lang.org/blob/main/docs/"
constant LANGUAGE = "https://github.com/sayon-lang/sayon/"
constant EDIT = "Edit this page on GitHub"

# A guide: its Markdown file in `docs`, its name in its address,
# /docs/<slug> ("" for /docs itself), its name among the guides, where its
# text is written and what the link there says, and its text made HTML.
type Guide = [source: string, slug: string, label: string, origin: string, change: string, document: markdown.Document]

# The guides' files, addresses, names, and where their text is written, in
# the order they are read. The last two are the language's `references`.
private function listed() -> Array<Array<string>>
    return [
        ["index.md", "", "Overview", SOURCES + "index.md", clone(EDIT)],
        ["installing.md", "installing", "Installing", SOURCES + "installing.md", clone(EDIT)],
        ["language.md", "language", "The language", SOURCES + "language.md", clone(EDIT)],
        ["api.md", "api", "Standard library", LANGUAGE + "tree/main/stdlib", "Written from the library's declarations"],
        ["errors.md", "errors", "Error codes", LANGUAGE + "blob/main/docs/errors.md", clone(EDIT)]
    ]

# The references written beside the language's code, in the `docs` folder
# of sayon-lang/sayon, of which `docs` here holds copies, made by
# scripts/language_docs.sayon.
function references() -> Array<string>
    return ["api.md", "errors.md"]

# The references whose copy in `folder` is not the text in the `docs` of
# the language's checkout at `language`.
function stale(language: string, folder: string) -> Array<string>
    out: Array<string> = []
    for name in references()
        theirs = filesystem.join(filesystem.join(language, "docs"), name)
        ours = filesystem.join(folder, name)
        if not filesystem.is_file(ours) or io.read_file(ours) != io.read_file(theirs)
            push(out, clone(name))
    return out

# Reads the guides from `folder` and makes them HTML.
function load(folder: string) -> Array<Guide>
    out: Array<Guide> = []
    for entry in listed()
        source = io.read_file(filesystem.join(folder, entry[0]))
        push(out, Guide(source = clone(entry[0]), slug = clone(entry[1]), label = clone(entry[2]), origin = clone(entry[3]), change = clone(entry[4]), document = markdown.convert(source)))
    return out

# Where a guide is.
function address(guide: Guide) -> string
    if guide.slug == ""
        return "/docs"
    return "/docs/" + guide.slug

# The position of the guide at /docs/<slug>, or nothing.
function find(guides: Array<Guide>, slug: string) -> integer or nothing
    for position in range(length(guides))
        if guides[position].slug == slug
            return position
    return nothing

# A long page's sections and their subsections, as a list of links; none
# for a page of fewer than four sections.
private function contents(document: markdown.Document) -> Array<string>
    out: Array<string> = []
    sections = 0
    for heading in document.headings
        if heading.level == 2
            sections += 1
    if sections < 4
        return out
    push(out, "<ul>")
    open = false
    for heading in document.headings
        entry = "<a href=\"#{heading.id}\">{html.text(heading.title)}</a>"
        if heading.level == 2
            if open
                push(out, "  </ul></li>")
            push(out, "  <li>" + entry + "<ul>")
            open = true
        elseif heading.level == 3 and open
            push(out, "    <li>" + entry + "</li>")
    if open
        push(out, "  </ul></li>")
    push(out, "</ul>")
    return out

# The page of the guide at `position`, for `view`.
function page(guides: Array<Guide>, position: integer, view: layout.Visitor) -> http.Response
    sections = contents(guides[position].document)
    kind = "docs"
    if length(sections) == 0
        kind = "docs narrow"
    out: Array<string> = []
    push(out, "<div class=\"{kind}\">")
    push(out, "  <nav class=\"guides\" aria-label=\"Guides\">")
    push(out, "    <h2>Guides</h2>")
    push(out, "    <ul>")
    for index in range(length(guides))
        current = ""
        if index == position
            current = " aria-current=\"page\""
        push(out, "      <li><a href=\"{address(guides[index])}\"{current}>{html.text(guides[index].label)}</a></li>")
    push(out, "    </ul>")
    push(out, "  </nav>")
    push(out, "  <article class=\"prose\">")
    if length(sections) > 0
        push(out, "    <details class=\"toc-inline\">")
        push(out, "      <summary>On this page</summary>")
        push(out, "      <nav class=\"toc\" aria-label=\"On this page\">")
        for line in sections
            push(out, "        " + line)
        push(out, "      </nav>")
        push(out, "    </details>")
    push(out, clone(guides[position].document.body))
    push(out, "    <div class=\"page-end\"><span>{html.text(guides[position].label)}</span><a href=\"{guides[position].origin}\">{html.text(guides[position].change)}</a></div>")
    push(out, "    <nav class=\"pager\" aria-label=\"The guides before and after this one\">")
    if position > 0
        push(out, "      <a href=\"{address(guides[position - 1])}\"><small>Previous</small>{html.text(guides[position - 1].label)}</a>")
    if position + 1 < length(guides)
        push(out, "      <a class=\"next\" href=\"{address(guides[position + 1])}\"><small>Next</small>{html.text(guides[position + 1].label)}</a>")
    push(out, "    </nav>")
    push(out, "  </article>")
    if length(sections) > 0
        push(out, "  <nav class=\"toc\" aria-label=\"On this page\">")
        push(out, "    <h2>On this page</h2>")
        for line in sections
            push(out, "    " + line)
        push(out, "  </nav>")
    push(out, "</div>")
    title = guides[position].document.title + " · Sayon docs"
    if guides[position].slug == ""
        title = "Sayon's documentation"
    return layout.page(view, title, out, 200, true, "docs", "The guides to Sayon: installing it, and the language from values and ownership to projects, packages, and targets.")
