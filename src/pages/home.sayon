# Sayon's first page: what Sayon is like, a first program, and how to
# start.

strings = import("standard/strings.sayon")
docs = import("src/pages/docs.sayon")
highlight = import("src/web/highlight.sayon")
html = import("src/web/html.sayon")
http = import("src/web/http.sayon")
layout = import("src/web/layout.sayon")

constant GITHUB = "https://github.com/sayon-lang"

# What Sayon is like: a heading and a few sentences, with `code` marked.
type Point = [title: string, text: string]

# A first program, shown as Sayon writes it.
function sample() -> string
    return strings.join([
        "function total(values: Array<integer>) -> integer",
        "    result = 0",
        "    for value in values",
        "        result = result + value",
        "    return result",
        "",
        "numbers = [1, 2, 3]",
        "print(\"Sum: {{total(numbers)}}\")",
        "print(length(numbers))  # numbers is still owned here"
    ], "\n")

# What `sayon run` prints for the program.
function output() -> string
    return "Sum: 6\n3"

# What `sayon check` says of a value used after it moved, in the compiler's
# own words.
function diagnostic() -> Array<string>
    return [
        "error[E_MOVED_VALUE]: `names` was transferred to `team`",
        "  --> moved.sayon:3:14",
        "   |",
        " 2 | team = names",
        "   |        ----- ownership transferred here",
        " 3 | print(length(names))",
        "   |              ^^^^^ `names` no longer owns the array",
        "   |",
        "   = help: use `team` here, or write `team = clone(names)` when you need two independent copies"
    ]

function points() -> Array<Point>
    return [
        Point(title = "Reads like what it does", text = "Blocks by indentation, whole words for keywords, and values written into strings where they go. Types are inferred, and you name them where it helps."),
        Point(title = "Safe without trying", text = "The compiler checks ownership and infers borrowing, so each value is cleaned up exactly once, at a time you can tell from the code. No garbage collector, no hidden copies."),
        Point(title = "One program, many places", text = "Run it in the interpreter, or compile it through LLVM to a native program for Windows or Linux, WebAssembly for WASI and web pages, or an Android app."),
        Point(title = "Errors that teach", text = "Every diagnostic has a stable code, points at the problem, and suggests a concrete fix. `sayon explain` says more about any of them.")
    ]

# The diagnostic as a terminal shows it, its first line and its help marked.
private function diagnostic_html() -> string
    lines: Array<string> = []
    for line in diagnostic()
        if strings.starts_with(line, "error[")
            push(lines, "<span class=\"error\">{html.text(line)}</span>")
        elseif strings.starts_with(line, "   = help:")
            push(lines, "<span class=\"help\">{html.text(line)}</span>")
        else
            push(lines, html.text(line))
    return strings.join(lines, "\n")

# The page, for `view`, with the guides' categories to explore.
function home(view: layout.Visitor, guides: docs.Docs) -> http.Response
    out: Array<string> = []
    push(out, "    <div class=\"wrap\">")
    push(out, "      <section class=\"hero\">")
    push(out, "        <div>")
    push(out, "          <h1>Programming made easy. Safety made automatic.</h1>")
    push(out, "          <p class=\"lead\">" + html.prose("Sayon means “easy”. Ordinary programs need fewer decisions, less boilerplate, and less setup, while the compiler checks who owns each value, so memory is freed on time without a garbage collector.") + "</p>")
    push(out, "          <div class=\"buttons\">")
    push(out, "            <a class=\"button primary large\" href=\"/docs/get-started/first-program\">Get started</a>")
    push(out, "            <a class=\"button large\" href=\"/docs\">Read the docs</a>")
    push(out, "          </div>")
    push(out, "        </div>")
    push(out, "        <figure class=\"editor\" aria-label=\"A Sayon program and what it prints\">")
    push(out, "          <div class=\"editor-tabs\"><span class=\"open\">hello.sayon</span></div>")
    push(out, "          <pre><code>" + highlight.highlight(sample()) + "</code></pre>")
    push(out, "          <pre class=\"terminal\"><span class=\"prompt\">$ sayon run</span>")
    push(out, html.text(output()) + "</pre>")
    push(out, "        </figure>")
    push(out, "      </section>")
    push(out, "")
    push(out, "      <section class=\"points\" aria-label=\"What Sayon is like\">")
    for point in points()
        if point.title == "Errors that teach"
            push(out, "        <article class=\"wide\">")
            push(out, "          <div>")
            push(out, "            <h3>{html.text(point.title)}</h3>")
            push(out, "            <p>{html.prose(point.text)}</p>")
            push(out, "          </div>")
            push(out, "          <pre class=\"terminal\" aria-label=\"What sayon check says of a value used after it moved\">" + diagnostic_html() + "</pre>")
        else
            push(out, "        <article>")
            push(out, "          <h3>{html.text(point.title)}</h3>")
            push(out, "          <p>{html.prose(point.text)}</p>")
        push(out, "        </article>")
    push(out, "      </section>")
    push(out, "")
    push(out, "      <section class=\"section\" aria-label=\"How far Sayon has come\">")
    push(out, "        <div class=\"notice\"><p><strong>Early days.</strong> Sayon is in early development and not ready for real programs yet. What exists, what is planned, and for which milestone is in the <a href=\"{GITHUB}/sayon/blob/main/docs/features.md\">feature ledger</a>.</p></div>")
    push(out, "      </section>")
    push(out, "")
    push(out, "      <section id=\"start\" class=\"section\" aria-labelledby=\"start-title\">")
    push(out, "        <h2 id=\"start-title\">Get started</h2>")
    push(out, "        <ol class=\"steps\">")
    push(out, "          <li>")
    push(out, "            <h3>Install Sayon</h3>")
    push(out, "            <p>Run the installer for your device. No release is out yet, so for now you build it from Sayon's source: <a href=\"/docs/get-started/installing\">Installing</a> shows how, for each device.</p>")
    push(out, "          </li>")
    push(out, "          <li>")
    push(out, "            <h3>Make a project</h3>")
    push(out, "            <p>Open a new terminal, then:</p>")
    push(out, "            <pre><code>sayon init hello")
    push(out, "cd hello")
    push(out, "sayon run</code></pre>")
    push(out, "          </li>")
    push(out, "          <li>")
    push(out, "            <h3>Set up your editor</h3>")
    push(out, "            <p>For VS Code, install the <a href=\"{GITHUB}/sayon-vscode\">Sayon extension</a>: highlighting, errors as you type, completion, and more.</p>")
    push(out, "          </li>")
    push(out, "        </ol>")
    push(out, "        <p class=\"after-steps\"><a href=\"/docs/get-started/first-program\">Your first program</a> goes on from there, step by step.</p>")
    push(out, "      </section>")
    if length(guides.categories) > 0
        push(out, "")
        push(out, "      <section class=\"section\" aria-labelledby=\"explore-title\">")
        push(out, "        <h2 id=\"explore-title\">Explore the docs</h2>")
        push(out, "        <div class=\"explore\">")
        for category in guides.categories
            push(out, "          <article class=\"box explore-card\">")
            push(out, "            <h3><a href=\"/docs/{category.key}\">{html.text(category.label)}</a></h3>")
            push(out, "            <p>{category.summary}</p>")
            push(out, "          </article>")
        push(out, "        </div>")
        push(out, "      </section>")
    push(out, "    </div>")
    return layout.page(view, "Sayon: Programming made easy. Safety made automatic.", out, 200, true, "", "Sayon is a readable programming language whose compiler checks ownership for you: no garbage collector, no hidden copies, and errors that say how to fix them.")
