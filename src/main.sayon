# Runs Sayon's website: its first page, the guides of `docs`, the package
# registry with its API and its index, and accounts, on this computer.
#
#     sayon run -- [--port 4100] [--data data] [--index <folder>] [--account <name>]... [--admin <name>]...
#     sayon run -- [--port 4100] [--data data] --reset <name>
#
# Run it from this folder. It serves at http://127.0.0.1:<port> (`--port 0`
# takes a free one), which at port 4100 is `sayon`'s registry by default;
# reads the guides of `docs` once, as it starts; and keeps accounts,
# owners, and archives in `--data`, and the index in `--index` (by default
# `index` inside the data folder; a clone of packages-index gets a commit
# for each publication). Once it listens it prints one line of JSON: its
# address, its index's address, and a token for each `--account`, which it
# makes, or whose tokens it replaces with that one. The operator's token,
# for making accounts later, is SAYON_REGISTRY_ADMIN_TOKEN. People make
# their own accounts on its pages. Each `--admin` makes an account an admin
# of the website, who appoints the forum's moderators.
#
# `--reset <name>` serves nothing: it prints a line of JSON with a link
# that chooses the account's password, once, within an hour, for an
# account made with `--account` or a password forgotten. The website
# serving that data folder at that port answers it.

filesystem = import("standard/filesystem.sayon")
json = import("standard/json.sayon")
network = import("standard/network.sayon")
os = import("standard/os.sayon")
accounts = import("src/accounts/accounts.sayon")
docs = import("src/pages/docs.sayon")
registry = import("src/packages/registry.sayon")
server = import("src/server.sayon")
sessions = import("src/accounts/sessions.sayon")

type Options = [port: integer, data: string, index: string, accounts: Array<string>, admins: Array<string>, reset: string]

type Started = [url: string, index: string, data: string, accounts: Dict<string, string>]

type ResetLink = [account: string, link: string]

function options(arguments: Array<string>) -> Options
    port = 4100
    data = "data"
    index = ""
    reset = ""
    names: Array<string> = []
    admins: Array<string> = []
    position = 0
    while position < length(arguments)
        option = clone(arguments[position])
        if position + 1 >= length(arguments)
            error("{option} needs a value")
        value = clone(arguments[position + 1])
        if option == "--port"
            given = tonumber(value)
            if typeof(given) != "integer" or given < 0 or given > 65535
                error("the port is a number from 0 to 65535, not {value}")
            port = given
        elseif option == "--data"
            data = value
        elseif option == "--index"
            index = value
        elseif option == "--account"
            push(names, value)
        elseif option == "--admin"
            push(admins, value)
        elseif option == "--reset"
            reset = value
        else
            error("unknown option {option}; the options are --port, --data, --index, --account, --admin, and --reset")
        position += 2
    if index == ""
        index = filesystem.join(data, "index")
    return Options(port = port, data = data, index = index, accounts = names, admins = admins, reset = reset)

# Prints a link that chooses an account's password.
function print_reset(chosen: Options)
    if not filesystem.is_directory(chosen.data)
        error("there is no data folder {chosen.data}")
    accounts.upgrade(chosen.data)
    if not haskey(accounts.accounts(chosen.data), chosen.reset)
        error("there is no account `{chosen.reset}` in {chosen.data}")
    if chosen.port == 0
        error("the link needs the port the registry serves at, such as --port 4100")
    all = sessions.resets(chosen.data)
    secret = sessions.new_reset(all, chosen.reset)
    sessions.save_resets(chosen.data, all)
    print(json.encode_value(ResetLink(account = clone(chosen.reset), link = "http://127.0.0.1:{chosen.port}/reset/{secret}")))

function main()
    chosen = options(os.arguments())
    if chosen.reset != ""
        print_reset(chosen)
        return
    filesystem.create_directory(chosen.data)
    filesystem.create_directory(chosen.index)
    accounts.upgrade(chosen.data)
    admin = accounts.new_token()
    given = os.environment("SAYON_REGISTRY_ADMIN_TOKEN")
    if given != nothing and given != ""
        admin = given
    all = accounts.accounts(chosen.data)
    kept = accounts.tokens(chosen.data)
    made: Dict<string, string> = []
    for name in chosen.accounts
        token = accounts.make(all, kept, name, true)
        if token != nothing
            made[clone(name)] = token
    for name in chosen.admins
        if not haskey(all, name)
            error("there is no account `{name}` to make an admin")
        all[name].role = "admin"
    accounts.save_tokens(chosen.data, kept)
    accounts.save_accounts(chosen.data, all)
    listener = network.listen("127.0.0.1", chosen.port)
    address = "http://127.0.0.1:{listener.address().port}"
    state = registry.State(data = clone(chosen.data), index = clone(chosen.index), address = clone(address), admin = admin, guides = docs.load("docs"))
    print(json.encode_value(Started(url = clone(address), index = address + "/index", data = clone(chosen.data), accounts = made)))
    server.serve(listener, state)
