filesystem = import("standard/filesystem.sayon")
json = import("standard/json.sayon")
network = import("standard/network.sayon")
strings = import("standard/strings.sayon")
threads = import("standard/threads.sayon")
docs = import("src/pages/docs.sayon")
registry = import("src/packages/registry.sayon")
server = import("src/server.sayon")
client = import("tests/client.sayon")

constant DATA = "build/test-accounts"

type Started = [secret: string, code: string, interval: integer, expires: integer]
type Polled = [status: string, account: string or nothing, token: string or nothing]
type Me = [name: string]

test "accounts are made and signed in to, and approve the sign-ins sayon login starts"
    client.clear(DATA)
    filesystem.create_directory(filesystem.join(DATA, "index"))
    listener = network.listen("127.0.0.1", 0)
    port = listener.address().port
    address = "http://127.0.0.1:{port}"
    state = registry.State(data = clone(DATA), index = filesystem.join(DATA, "index"), address = clone(address), admin = "operator", guides = docs.none())
    running = threads.spawn(function()
        server.serve(listener, state, 18)
    )
    form: Dict<string, string> = ["Content-Type" = "application/x-www-form-urlencoded", "Origin" = clone(address)]
    elsewhere: Dict<string, string> = ["Content-Type" = "application/x-www-form-urlencoded", "Origin" = "https://example.com"]
    fields = "name=ada&email=ada%40example.com&password=correct+horse+battery+staple&again=correct+horse+battery+staple&next=%2Faccount"

    # A form from another site does nothing.
    refused = client.send(port, "POST", "/sign-up", elsewhere, fields)
    assert(refused.status == 403 and client.cookie_of(refused) == "", refused.body)

    made = client.send(port, "POST", "/sign-up", form, fields)
    assert(made.status == 303 and client.header_of(made, "location") == "/account", made.body)
    cookie = client.cookie_of(made)
    assert(strings.starts_with(cookie, "sayon_session=") and length(cookie) == 78, cookie)
    assert(strings.contains(client.header_of(made, "set-cookie"), "HttpOnly; SameSite=Lax"))
    signed: Dict<string, string> = ["Cookie" = clone(cookie)]
    page = client.send(port, "GET", "/account", signed, "")
    assert(page.status == 200 and strings.contains(page.body, "<h1>ada</h1>"), page.body)
    assert(client.header_of(page, "x-frame-options") == "DENY" and client.header_of(page, "cache-control") == "no-store")
    # The account's pages share tabs, the one shown marked.
    assert(strings.contains(page.body, "<nav class=\"tabs\" aria-label=\"Your account\"><a href=\"/account\" aria-current=\"page\">Overview</a><a href=\"/account/tokens\">Tokens</a><a href=\"/account/settings\">Settings</a><a class=\"tabs-aside\" href=\"/users/ada\">Your profile</a></nav>"), page.body)

    # sayon login starts a sign-in, which waits until it is approved.
    begun = client.send(port, "POST", "/api/v1/logins", [], "{{\"machine\": \"test computer\"}}")
    assert(begun.status == 201, begun.body)
    started: Started = json.decode(begun.body)
    asked = "{{\"secret\": \"{started.secret}\"}}"
    waiting: Polled = json.decode(client.send(port, "POST", "/api/v1/logins/poll", [], asked).body)
    assert(waiting.status == "waiting" and waiting.token == nothing)
    approval = client.send(port, "GET", "/login/" + started.code, signed, "")
    assert(approval.status == 200 and strings.contains(approval.body, "Approve this sign-in?") and strings.contains(approval.body, "test computer"), approval.body)
    with_cookie: Dict<string, string> = clone(form)
    with_cookie["Cookie"] = clone(cookie)
    approved = client.send(port, "POST", "/login/" + started.code, with_cookie, "decision=approve")
    assert(approved.status == 303, approved.body)
    given: Polled = json.decode(client.send(port, "POST", "/api/v1/logins/poll", [], asked).body)
    assert(given.status == "approved" and given.account == "ada", given.status)
    assert(client.send(port, "POST", "/api/v1/logins/poll", [], asked).status == 404)
    token = clone(given.token)
    if token == nothing
        assert(false, "the approved sign-in gave no token")
        return
    bearer: Dict<string, string> = ["Authorization" = "Bearer " + token]
    me: Me = json.decode(client.send(port, "GET", "/api/v1/me", bearer, "").body)
    assert(me.name == "ada")

    # sayon logout revokes it.
    assert(client.send(port, "DELETE", "/api/v1/tokens/current", bearer, "").status == 200)
    assert(client.send(port, "GET", "/api/v1/me", bearer, "").status == 401)

    wrong = client.send(port, "POST", "/sign-in", form, "name=ada&password=not+the+password")
    assert(wrong.status == 401 and strings.contains(wrong.body, "is wrong") and client.cookie_of(wrong) == "")

    # From a sign-in's page, an account is made and the sign-in approved at once.
    other: Started = json.decode(client.send(port, "POST", "/api/v1/logins", [], "").body)
    joined = client.send(port, "POST", "/sign-up", form, "name=bo&email=bo%40example.com&password=bo+likes+long+passwords&again=bo+likes+long+passwords&approve=yes&next=%2Flogin%2F" + other.code)
    assert(joined.status == 303 and client.header_of(joined, "location") == "/login/" + other.code, joined.body)
    for_bo: Polled = json.decode(client.send(port, "POST", "/api/v1/logins/poll", [], "{{\"secret\": \"{other.secret}\"}}").body)
    assert(for_bo.status == "approved" and for_bo.account == "bo" and for_bo.token != nothing)

    out = client.send(port, "POST", "/sign-out", with_cookie, "")
    assert(out.status == 303 and strings.contains(client.header_of(out, "set-cookie"), "Max-Age=0"))
    assert(client.send(port, "GET", "/account", signed, "").status == 303)
    threads.join(running)
