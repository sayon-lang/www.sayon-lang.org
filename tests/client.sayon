##
What the website's tests share: a client that speaks HTTP as a browser
does and sees each answer as it comes, accounts signed in without their
pages, and clearing a test's folder.
##

filesystem = import("standard/filesystem.sayon")
io = import("standard/io.sayon")
network = import("standard/network.sayon")
strings = import("standard/strings.sayon")
accounts = import("src/accounts/accounts.sayon")
sessions = import("src/accounts/sessions.sayon")
docs = import("src/pages/docs.sayon")
registry = import("src/packages/registry.sayon")

##
An answer as the website wrote it: its status, its headers by lowercase
name, and its body.
##
type Answer = [status: integer, headers: Dict<string, string>, body: string]

# An answer whose body is bytes, such as an image.
type Bytes = [status: integer, headers: Dict<string, string>, body: Array<byte>]

##
A request with a body of bytes, and the answer: its head read line by
line, and its body as long as its `Content-Length` says.
##
function send_bytes(port: integer, method: string, target: string, headers: Dict<string, string>, body: Array<byte>) -> Bytes
    connection = network.connect("127.0.0.1", port)
    connection.write("{method} {target} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nContent-Length: {length(body)}\r\nConnection: close\r\n")
    for name, value in headers
        connection.write("{name}: {value}\r\n")
    connection.write("\r\n")
    connection.write_bytes(body)
    connection.flush()
    first = connection.read_line()
    if first == nothing
        error("the website closed the connection without an answer")
    status = strings.parse_integer(strings.split(first, " ")[1])
    headers_read: Dict<string, string> = []
    while true
        line = connection.read_line()
        if line == nothing or line == ""
            break
        colon = strings.find(line, ":")
        if colon != nothing
            headers_read[strings.lower(strings.trim(strings.slice(line, 0, colon)))] = strings.trim(strings.slice(line, colon + 1, length(line)))
    size = 0
    if haskey(headers_read, "content-length")
        size = strings.parse_integer(headers_read["content-length"])
    return Bytes(status = status, headers = headers_read, body = connection.read_exactly(size))

##
A form of one file as a browser sends it, as multipart/form-data: the
Content-Type to send it with, and its body.
##
type Multipart = [kind: string, body: Array<byte>]

function multipart(field: string, file: string, kind: string, bytes: Array<byte>) -> Multipart
    boundary = "----SayonTestBoundary7MA4YWxkTrZu0gW"
    body = strings.bytes("--{boundary}\r\nContent-Disposition: form-data; name=\"{field}\"; filename=\"{file}\"\r\nContent-Type: {kind}\r\n\r\n")
    for value in bytes
        push(body, value)
    for value in strings.bytes("\r\n--{boundary}--\r\n")
        push(body, value)
    return Multipart(kind = "multipart/form-data; boundary={boundary}", body = body)

# A fresh data folder, and the state of a website serving it at `port`.
function website(data: string, port: integer) -> registry.State
    clear(data)
    filesystem.create_directory(filesystem.join(data, "index"))
    return registry.State(data = clone(data), index = filesystem.join(data, "index"), address = "http://127.0.0.1:{port}", admin = "operator", guides = docs.none())

##
Makes verified accounts, a year old, each signed in: the headers that
its forms are sent with, by name.
##
function people(data: string, port: integer, names: Array<string>) -> Dict<string, Dict<string, string>>
    all = accounts.accounts(data)
    kept = sessions.sessions(data)
    out: Dict<string, Dict<string, string>> = []
    for name in names
        record = accounts.new_account(nothing, "{name}@example.com", true)
        record.created = "2025-11-01T00:00:00Z"
        all[clone(name)] = record
        id = sessions.start(kept, name)
        headers: Dict<string, string> = ["Content-Type" = "application/x-www-form-urlencoded", "Origin" = "http://127.0.0.1:{port}", "Cookie" = "{sessions.COOKIE}={id}"]
        out[clone(name)] = headers
    accounts.save_accounts(data, all)
    sessions.save_sessions(data, kept)
    return out

function clear(folder: string)
    if not filesystem.exists(folder)
        return
    entries = filesystem.walk(folder)
    position = length(entries) - 1
    while position >= 0
        filesystem.remove(filesystem.join(folder, entries[position]))
        position -= 1
    filesystem.remove(folder)

##
A request on a connection of its own, as a browser sends it, and the
answer as it comes: a redirect, and the cookie it sets, are not followed.
##
function send(port: integer, method: string, target: string, headers: Dict<string, string>, body: string) -> Answer
    connection = network.connect("127.0.0.1", port)
    connection.write("{method} {target} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nContent-Length: {bytelength(body)}\r\nConnection: close\r\n")
    for name, value in headers
        connection.write("{name}: {value}\r\n")
    connection.write("\r\n" + body)
    connection.flush()
    text = connection.read()
    end = strings.find(text, "\r\n\r\n")
    if end == nothing
        error("the website's answer has no end to its headers: {text}")
    head = strings.split(strings.slice(text, 0, end), "\r\n")
    status = strings.parse_integer(strings.split(head[0], " ")[1])
    headers_read: Dict<string, string> = []
    for position in range(1, length(head))
        line = clone(head[position])
        colon = strings.find(line, ":")
        if colon != nothing
            headers_read[strings.lower(strings.trim(strings.slice(line, 0, colon)))] = strings.trim(strings.slice(line, colon + 1, length(line)))
    return Answer(status = status, headers = headers_read, body = strings.slice(text, end + 4, length(text)))

##
A test's talk with the website: its port, and how many requests it sent,
so that it can make up the count of requests the server was given.
##
type Talk = [port: integer, sent: integer]

# A request as `send` makes it, counted.
function ask(update talk: Talk, method: string, target: string, headers: Dict<string, string>, body: string) -> Answer
    talk.sent += 1
    return send(talk.port, method, target, headers, body)

# A request as `send_bytes` makes it, counted.
function ask_bytes(update talk: Talk, method: string, target: string, headers: Dict<string, string>, body: Array<byte>) -> Bytes
    talk.sent += 1
    return send_bytes(talk.port, method, target, headers, body)

##
Sends quick requests until `count` were sent, so that a server given
that count returns.
##
function finish(update talk: Talk, count: integer)
    while talk.sent < count
        ask(talk, "GET", "/api/v1", [], "")

function header_of(answer: Answer, name: string) -> string
    if haskey(answer.headers, name)
        return clone(answer.headers[name])
    return ""

# The cookie an answer sets, as a request sends it back.
function cookie_of(answer: Answer) -> string
    set = header_of(answer, "set-cookie")
    end = strings.find(set, ";")
    if end == nothing
        return set
    return strings.slice(set, 0, end)

##
The address of the link in the newest mail to `to` whose address holds
`part`, such as /verify/, as the website kept it in `<data>/mail`; the
mail is then put away, so that the next look finds the next one.
##
function mail_link(data: string, to: string, part: string) -> string
    folder = filesystem.join(data, "mail")
    names = filesystem.walk(folder)
    position = length(names) - 1
    while position >= 0
        file = filesystem.join(folder, names[position])
        position -= 1
        text = io.read_file(file)
        if strings.contains(text, "To: <{to}>")
            for line in strings.lines(text)
                at = strings.find(line, part)
                if at != nothing and strings.starts_with(line, "http")
                    filesystem.remove(file)
                    start = strings.find(line, "://")
                    if start != nothing
                        rest = strings.slice(line, start + 3, length(line))
                        slash = strings.find(rest, "/")
                        if slash != nothing
                            return strings.slice(rest, slash, length(rest))
    error("no mail to {to} holds a link with {part}")
